rsion":"1.10","preferredColorScheme":"dark"}],"textColor":"#FFFFFF"}],"fontAttributes":{"fontFamily":"Helvetica Neue","width":"condensed"},"fontSize":20,"identifier":"promo-heading","lineHeight":15,"textColor":"#102039"},"prosConsHeadingTextStyle":{"fontName":"HelveticaNeue-Bold","fontSize":15,"identifier":"prosConsHeadingTextStyle","lineHeight":24,"textColor":"#2A2A2A"},"prosConsTextStyle":{"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"light"}],"linkStyle":{"textColor":"#4372B8"},"textColor":"#2A2A2A"},{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"linkStyle":{"textColor":"#9FB7DB"},"textColor":"#D5D5D5"}],"fontName":"HelveticaNeue","fontSize":15,"identifier":"prosConsTextStyle","lineHeight":24},"pullQuoteCardTextStyle":{"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"textColor":"#FFF"}],"fontName":"HelveticaNeue-Bold","fontSize":24,"identifier":"pullQuoteCardTextStyle","textAlignment":"left","textColor":"#666"},"quoteTextStyle":{"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"textColor":"#FFF"}],"fontAttributes":{"style":"italic"},"fontName":"HelveticaNeue-Italic","fontSize":18,"identifier":"quoteTextStyle","textAlignment":"left","textColor":"#666"},"summaryBoxHeadlineTextStyle":{"fontName":"HelveticaNeue-Bold","fontSize":20,"identifier":"summaryBoxHeadlineTextStyle","lineHeight":24,"textColor":"#222"},"summaryBoxTextStyle":{"fontName":"HelveticaNeue","fontSize":18,"identifier":"summaryBoxTextStyle","lineHeight":27,"linkStyle":{"textColor":"#4372B8"},"textColor":"#222"},"titleTextStyle":{"fontName":"HelveticaNeue-Bold","fontSize":50,"hyphenation":false,"identifier":"titleTextStyle","lineHeight":60,"textColor":"#222"},"unorderedListTextStyle":{"fontName":"HelveticaNeue","fontSize":21,"identifier":"unorderedListTextStyle","lineHeight":31,"linkStyle":{"textColor":"#4372B8"},"textAlignment":"left","textColor":"#666"}},"components":[{"components":[{"identifier":"_anf-header-1","layout":"ComponentLayout-1","role":"header","style":"_anf-cs-1","type":"container"},{"identifier":"_anf-title-1","layout":"introLayout","role":"title","text":"More musicians cancel Kennedy Center concerts after board votes to add Trump's name","textStyle":"titleTextStyle","type":"text"},{"identifier":"_anf-caption-1","layout":"introLayout","role":"caption","text":"Recent cancellations have left the performing arts center in Washington with gaps in programming for Christmas Eve and New Year's Eve.","textStyle":"introTextStyle","type":"text"},{"identifier":"_anf-text-1","inlineTextStyles":[{"range":{"length":26,"start":0},"textStyle":"_anf-ts-1"}],"layout":"contentTimestampLayout","role":"body","text":"Dec. 29, 2025, 9:59 PM EST","textStyle":"_anf-moved-1","type":"text"},{"identifier":"_anf-byline-1","layout":"bylineLayout","role":"byline","text":"by Raquel Coronell Uribe | NBC NEWS","textStyle":"bylineTextStyle","type":"text"}],"identifier":"_anf-section-1","layout":"headerSectionImageLayout","role":"section","type":"section"},{"additions":[{"URL":"https://apple.news/AQTSaqM0qTbSuC7CzTkh4Gw","analytics":{"linkType":"web"},"range":{"length":13,"start":15},"type":"link"},{"URL":"https://apple.news/A3JnfJ-9VQM-WQflHb3DpmA","analytics":{"linkType":"web"},"range":{"length":15,"start":91},"type":"link"}],"identifier":"wrap1Text","inlineTextStyles":[{"range":{"length":174,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":174,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"More musicians have canceled their upcoming concerts at the Kennedy Center after its board voted to rename the performing arts venue to include President Donald Trump’s name.","textStyle":"bodyTextStyle","type":"text"},{"identifier":"wrap2Text","inlineTextStyles":[{"range":{"length":114,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":114,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"The canceled performances to date include shows previously promoted for Christmas Eve, New Year's Eve and Jan. 14.","textStyle":"bodyTextStyle","type":"text"},{"identifier":"wrap3Text","inlineTextStyles":[{"range":{"length":172,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":172,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"The Cookers, a jazz band that was scheduled to perform Wednesday night, did not cite a specific reason in announcing their decision, but their statement hinted at politics.","textStyle":"bodyTextStyle","type":"text"},{"additions":[{"URL":"https://www.thecookersmusic.com/","analytics":{"linkType":"web"},"range":{"length":14,"start":234},"type":"link"}],"identifier":"wrap4Text","inlineTextStyles":[{"range":{"length":329,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":329,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"“Jazz was born from struggle and from a relentless insistence on freedom: freedom of thought, of expression, and of the full human voice. Some of us have been making this music for many decades, and that history still shapes us,” the statement read. \"Our hope is that this moment will leave space for reflection, not resentment.\"","textStyle":"bodyTextStyle","type":"text"},{"additions":[{"URL":"https://www.instagram.com/p/DSldqHLldRi/?hl=en","analytics":{"linkType":"web"},"range":{"length":39,"start":50},"type":"link"}],"identifier":"wrap5Text","inlineTextStyles":[{"range":{"length":184,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":184,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"Kristy Lee, who was scheduled to perform Jan. 14, announced her cancellation on Instagram, saying canceling shows hurts, “but losing my integrity would cost me more than any paycheck.”","textStyle":"bodyTextStyle","type":"text"},{"identifier":"wrap6Text","inlineTextStyles":[{"range":{"length":249,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":249,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"“When American history starts getting treated like something you can ban, erase, rename, or rebrand for somebody else’s ego, I can’t stand on that stage and sleep right at night,” said Lee, who described herself as \"just a folk singer from Alabama.\"","textStyle":"bodyTextStyle","type":"text"},{"identifier":"wrap7Text","inlineTextStyles":[{"range":{"length":108,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":108,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"She said that instead of playing at the Kennedy Center next month, she would play a live show from her home.","textStyle":"bodyTextStyle","type":"text"},{"additions":[{"URL":"https://www.kristyleemusic.com/about-4","analytics":{"linkType":"web"},"range":{"length":24,"start":14},"type":"link"}],"identifier":"wrap8Text","inlineTextStyles":[{"range":{"length":258,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":258,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"In a separate statement on her website, Lee said the cancellation was due to concerns for the center’s “institutional integrity.” She said she “believes publicly funded spaces must remain free from political capture, self-promotion, or ideological pressure.”","textStyle":"bodyTextStyle","type":"text"},{"identifier":"wrap9Text","inlineTextStyles":[{"range":{"length":308,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":308,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"“This decision is not directed at the Center’s dedicated staff, artists, or patrons, whose work and commitment to the arts remain deeply respected. Rather, it is a statement in defense of the Center’s founding purpose and the ethical responsibility shared by artists who grace its stage,” the statement read.","textStyle":"bodyTextStyle","type":"text"},{"components":[{"identifier":"_anf-caption-2","layout":"_defaultComponentLayout","role":"caption","text":"Email Newsletters","textStyle":"_anf-cts-1","type":"text"},{"identifier":"_anf-heading3-1","layout":"_defaultComponentLayout","role":"heading3","text":"Direct To Your Inbox","textStyle":"_anf-cts-2","type":"text"},{"components":[{"identifier":"_anf-image-1","imageIdentifier":"6eee588f257f86f2f7f2f1c12d5e8cbc","layout":"newsletterImageLayout-ComponentLayout-1","role":"image","type":"image"},{"anchor":{"targetAnchorPosition":"center"},"identifier":"_anf-text-2","layout":"newsletterTextLayout-ComponentLayout-1","role":"body","text":"Get the latest breaking news and must-read articles from NBC News","textStyle":"_anf-cts-3","type":"text"},{"action":{"URL":"https://www.nbcnews.com/newsletters","analytics":{"linkType":"web"},"type":"link"},"anchor":{"targetAnchorPosition":"center"},"identifier":"_anf-link_button-1","layout":"linkButtonLayout-ComponentLayout-1","role":"link_button","style":"linkButtonStyle","text":"+","textStyle":"buttonTextStyle","type":"button"}],"contentDisplay":{"type":"horizontal_stack"},"identifier":"_anf-container-2","layout":"newsletterLayout-ComponentLayout-1","role":"container","style":"newsletterContainerStyle","type":"container"}],"identifier":"_anf-container-1","layout":"outerNewsletterContainer","role":"container","type":"container"},{"identifier":"wrap10Text","inlineTextStyles":[{"range":{"length":105,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":105,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"The Kennedy Center, Lee and The Cookers did not immediately respond to requests for comment Monday night.","textStyle":"bodyTextStyle","type":"text"},{"identifier":"a2db6a","layout":"_defaultComponentLayout","role":"body","text":"","type":"text"},{"accessibilityCaption":"WH: Board adds Trump name to Kennedy Center | The White House said the board of the Kennedy Center changed its name to include President Trump. NBC News’ Gabe Gutierrez reports. | Nightly News Video","aspectRatio":1.777,"caption":"Nightly News Video: WH: Board adds Trump name to Kennedy Center | 'The White House said the board of the Kennedy Center changed its name to include President Trump. NBC News’ Gabe Gutierrez reports.","identifier":"_anf-video-1","layout":"ecommerceDisclaimerContainer","resourceIdentifier":"VideoResourceRef-1","role":"video","stillImageIdentifier":"ef92ea2b0b8892e071401fad369f4240","type":"video"},{"additions":[{"URL":"https://www.nytimes.com/2025/12/29/arts/kennedy-center-new-years-eve-concerts-canceled.html","analytics":{"linkType":"web"},"range":{"length":23,"start":34},"type":"link"}],"identifier":"wrap12Text","inlineTextStyles":[{"range":{"length":195,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":195,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"The Cookers’ drummer, Billy Hart, told The New York Times, which first reported the recent cancellations, that the name change “evidently” played a role in their decision to cancel their concert.","textStyle":"bodyTextStyle","type":"text"},{"identifier":"wrap13Text","inlineTextStyles":[{"range":{"length":359,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":359,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"The Kennedy Center’s board voted to change the institution's name this month. The next day, Trump’s name was affixed to the building’s facade, prompting criticism from lawmakers and members of the Kennedy family, who said the institution was created by Congress to memorialize President John F. Kennedy and could not be renamed without congressional approval.","textStyle":"bodyTextStyle","type":"text"},{"additions":[{"URL":"https://apple.news/AxDZeIphxQICAdMye2j3flQ","analytics":{"linkType":"web"},"range":{"length":29,"start":62},"type":"link"}],"identifier":"wrap14Text","inlineTextStyles":[{"range":{"length":173,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":173,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"Rep. Joyce Beatty, D-Ohio, an ex officio member of the board, sued the Trump administration last week for the renaming, calling it a “flagrant violation of the rule of law.”","textStyle":"bodyTextStyle","type":"text"},{"additions":[{"URL":"https://www.nbcnews.com/politics/trump-administration/kennedy-center-christmas-eve-jazz-concert-canceled-trump-name-added-rcna250894","analytics":{"linkType":"web"},"range":{"length":25,"start":236},"type":"link"}],"identifier":"wrap15Text","inlineTextStyles":[{"range":{"length":327,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":327,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"One of the first musicians to cancel a performance in the wake of the board's vote was jazz musician Chuck Redd, who called off his Christmas Eve concert at the center, where had presided over the annual event for nearly 20 years. Redd told The Associated Press that he was canceling the concert as a result of the name change.","textStyle":"bodyTextStyle","type":"text"},{"additions":[{"URL":"https://apple.news/AQTSaqM0qTbSuC7CzTkh4Gw","analytics":{"linkType":"web"},"range":{"length":23,"start":122},"type":"link"}],"identifier":"wrap16Text","inlineTextStyles":[{"range":{"length":200,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":200,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"In a letter to Redd, which the Kennedy Center shared with NBC News, the center’s president, Richard Grenell, threatened to sue him for $1 million, calling his decision to back out a “political stunt.”","textStyle":"bodyTextStyle","type":"text"},{"identifier":"wrap17Text","inlineTextStyles":[{"range":{"length":307,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":307,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"In a statement Saturday, Kennedy Center spokesperson Roma Daravi said, \"Any artist cancelling their show at the Trump Kennedy Center over political differences isn’t courageous or principled—they are selfish, intolerant, and have failed to meet the basic duty of a public artist: to perform for all people.\"","textStyle":"bodyTextStyle","type":"text"},{"additions":[{"URL":"https://apple.news/ASSYGJJtSTpSZG1BlKqQ6wQ","analytics":{"linkType":"web"},"range":{"length":21,"start":136},"type":"link"},{"URL":"https://apple.news/Apo2pqVliR2OvikyXoHllJw","analytics":{"linkType":"web"},"range":{"length":21,"start":221},"type":"link"}],"identifier":"wrap18Text","inlineTextStyles":[{"range":{"length":243,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":243,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"Trump has taken numerous steps to assert more control over the center, such as replacing the board with a handpicked set of members who named him their chair. He also changed the programming at the center, which included removing Pride events.","textStyle":"bodyTextStyle","type":"text"},{"identifier":"wrap19Text","inlineTextStyles":[{"range":{"length":141,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":141,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyLayout","role":"body","text":"Multiple shows and performers have canceled events at the center since Trump’s takeover began, including the musical \"Hamilton\" and Issa Rae.","textStyle":"bodyTextStyle","type":"text"}],"documentStyle":{"backgroundColor":"#ffffff"},"hints":{"conditionals":{"autoplacement":false,"componentLayouts":true,"componentStyles":true,"componentTextStyles":true,"components":false,"documentStyle":false,"textStyles":false},"conditions":{"_anf_testing":false,"app":false,"configurationKey":false,"experimentVariant":false,"following":false,"horizontalSizeClass":false,"maxColumns":false,"maxContentSizeCategory":false,"maxSpecVersion":false,"maxViewportAspectRatio":false,"maxViewportWidth":false,"