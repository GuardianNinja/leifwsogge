{"version":2,"initialFileContents":[["file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py","439644f"]],"timeline":{"checkpoints":[{"checkpointId":"183e27d4-7f4d-413d-b4ec-f309cdc75c8f","epoch":0,"label":"Initial State","description":"Starting point before any edits"},{"checkpointId":"45f4d732-134b-484c-bfc6-175a864ae759","requestId":"request_b707b0d2-f657-44e3-8053-a1590fe24346","epoch":1,"label":"Request request_b707b0d2-f657-44e3-8053-a1590fe24346"},{"checkpointId":"2f01696c-184e-43f7-8b20-7178c664b4a2","requestId":"request_b707b0d2-f657-44e3-8053-a1590fe24346","undoStopId":"a9ca05fd-917d-4cfc-87e5-afc46af08925","epoch":2,"label":"Request request_b707b0d2-f657-44e3-8053-a1590fe24346 - Stop a9ca05fd-917d-4cfc-87e5-afc46af08925"}],"currentEpoch":38,"fileBaselines":[["file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py::request_b707b0d2-f657-44e3-8053-a1590fe24346",{"uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","scheme":"file"},"requestId":"request_b707b0d2-f657-44e3-8053-a1590fe24346","content":"\"\"\"\ngyroscope.py — Gyroscopic stability model\nSpace Leaf Corp — Internal Use Only\n\"\"\"\n\nimport numpy as np\n\ndef gyroscopic_S_time_series(\n    counts: list[float],\n    days: int = 3650,\n    omega0: float = 10.0,\n    c: float = 0.5,\n    impulse_every: int = None,\n    impulse_drop=0.05\n):\n    radii = [(i + 1) ** 2 for i in range(len(counts))]\n    masses = [cnt * 1e-3 for cnt in counts]\n    I_n = [(2/3) * m * (r**2) for m, r in zip(masses, radii)]\n    I_total = sum(I_n)\n\n    t = np.arange(0, days + 1)\n    omega = omega0 * np.exp(-c * t / days)\n\n    if impulse_every is not None:\n        try:\n            impulse_every_int = int(impulse_every)\n        except (TypeError, ValueError):\n            raise ValueError(\"impulse_every must be an integer or convertible to int\")\n        for day in range(impulse_every_int, days + 1, impulse_every_int):\n            omega[day:] *= (1 - impulse_drop)\n\n    S = omega / omega0\n    return t, S, I_total\n","epoch":3,"telemetryInfo":{}}]],"operations":[{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","scheme":"file"},"requestId":"request_b707b0d2-f657-44e3-8053-a1590fe24346","epoch":4,"edits":[{"text":"\"\"\"","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":1,"endColumn":4}}]},{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/sr