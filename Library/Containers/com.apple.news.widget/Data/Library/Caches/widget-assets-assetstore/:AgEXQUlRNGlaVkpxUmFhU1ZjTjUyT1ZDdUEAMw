ype":"image"},{"conditional":[{"conditions":[{"minSpecVersion":"1.14","preferredColorScheme":"dark"}],"hidden":false}],"hidden":true,"identifier":"_anf-logo-3","imageIdentifier":"36f08a68b52a1951d6f945c280e13008","layout":"ComponentLayout-17","role":"logo","type":"image"},{"conditional":[{"conditions":[{"minViewportWidth":671,"platform":"ios"},{"minViewportWidth":871,"platform":"macos"}],"hidden":true}],"identifier":"_anf-logo-4","imageIdentifier":"959dfd1a20c32ae9a0cc93d2b58255d7","layout":"ComponentLayout-19","role":"logo","type":"image"},{"identifier":"_anf-text-1","inlineTextStyles":[{"range":{"length":35,"start":0},"textStyle":"_anf-ts-5"}],"layout":"ComponentLayout-20","role":"body","text":"Finish setting up your subscription","textStyle":"_anf-moved-1","type":"text"},{"identifier":"_anf-text-2","layout":"ComponentLayout-21","role":"body","text":"Share your email to get unlimited access on washingtonpost.com and The Washington Post app.","textStyle":"_anf-cts-1","type":"text"},{"action":{"URL":"https://apple.news/TWnoJEyylRkqOFV6TfyhUnA/subscription/weboptin","analytics":{"linkType":"article"},"type":"link"},"identifier":"_anf-link_button-1","layout":"ComponentLayout-22","role":"link_button","style":"_anf-cs-2","text":"Share Your Email","textStyle":"_anf-cts-2","type":"button"}],"identifier":"_anf-container-10","layout":"promoContainerLayout","role":"container","type":"container"},{"conditional":[{"conditions":[{"minViewportWidth":671,"platform":"ios"},{"minViewportWidth":871,"platform":"macos"}],"hidden":false,"layout":"ComponentLayout-23"}],"hidden":true,"identifier":"_anf-logo-1","imageIdentifier":"959dfd1a20c32ae9a0cc93d2b58255d7","layout":"_defaultComponentLayout","role":"logo","type":"image"}],"conditional":[{"conditions":[{"configurationKey":"wapo_email_not_shared","minSpecVersion":"1.12"}],"hidden":false}],"contentDisplay":{"type":"horizontal_stack"},"hidden":true,"identifier":"_anf-container-7","layout":"ComponentLayout-1","role":"container","style":"_anf-cs-1","type":"container"},{"identifier":"_anf-body-4","inlineTextStyles":[{"range":{"length":116,"start":0},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"The Trump administration has been battling lawsuits aimed at removing the National Guard from cities in blue states.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-5","inlineTextStyles":[{"range":{"length":145,"start":0},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“We will come back, perhaps in a much different and stronger form, when crime begins to soar again — Only a question of time!” Trump’s post said.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-6","inlineTextStyles":[{"range":{"length":216,"start":0},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Troops had already been pulled from Los Angeles after being deployed in June to crack down on crime and immigration. In Chicago and Portland, troops were deployed, but never took to the streets amid legal challenges.","textStyle":"default-body","type":"text"},{"components":[{"identifier":"_anf-divider-1","layout":"newsletterSignupTopDividerLayout","role":"divider","stroke":{"color":"#d2d2d2","width":"1.0pt"},"type":"line"},{"additions":[{"URL":"https://subscribe.washingtonpost.com/newsletters/#/bundle/postmost?method=SURL&location=AN","analytics":{"linkType":"web"},"range":{"length":28,"start":0},"type":"link"}],"identifier":"_anf-body-13","inlineTextStyles":[{"range":{"length":28,"start":0},"textStyle":"_anf-ts-1"},{"range":{"length":28,"start":0},"textStyle":"_anf-ts-9"}],"layout":"newsletterBodyLayout","role":"body","text":"Get the Post Most Newsletter","textStyle":"imageAltTextTextStyle","type":"text"},{"identifier":"_anf-body-14","layout":"bioLayout","role":"body","text":"The most popular and interesting stories of the day to keep you in the know. In your inbox, every day.","textStyle":"imageAltTextTextStyle","type":"text"},{"identifier":"_anf-divider-2","layout":"bioLayout","role":"divider","stroke":{"color":"#d2d2d2","width":"1.0pt"},"type":"line"}],"identifier":"_anf-container-8","layout":"_defaultComponentLayout","role":"container","type":"container"},{"additions":[{"URL":"https://apple.news/Pg0GBEpf-1MgWUT4fpXh9x3","analytics":{"linkType":"web"},"range":{"length":21,"start":30},"type":"link"}],"identifier":"_anf-body-7","inlineTextStyles":[{"range":{"length":342,"start":0},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Shortly before Christmas, the Supreme Court blocked Trump’s deployment of the National Guard to Chicago. While the ruling was temporary and only applied directly to Illinois, it had significant ramifications for the president’s efforts to send the National Guard to cities across the country to fight crime and protect immigration facilities.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-8","inlineTextStyles":[{"range":{"length":307,"start":0},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Trump has claimed largely unfettered authority to deploy the National Guard, but the justices ruled he likely could only federalize the troops under “exceptional” circumstances such as a foreign invasion, rebellion or when the regular military is unable to enforce federal law because order has broken down.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-9","inlineTextStyles":[{"range":{"length":171,"start":0},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“At this preliminary stage, the Government has failed to identify a source of authority that would allow the military to execute the laws in Illinois,” the justices wrote.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-10","inlineTextStyles":[{"range":{"length":210,"start":0},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"National Guard members were deployed Tuesday in New Orleans to boost security during New Year’s celebrations and are expected to remain on the ground. Troops also remain on the ground in Washington and Memphis.","textStyle":"default-body","type":"text"},{"components":[{"identifier":"_anf-divider-3","layout":"authorInfoDividerLayout","role":"divider","stroke":{"color":"#2a2a2a","width":"1.0pt"},"type":"line"}],"identifier":"_anf-container-9","layout":"authorInfoDividerContainerLayout","role":"container","type":"container"},{"identifier":"_anf-body-11","inlineTextStyles":[{"range":{"length":131,"start":0},"textStyle":"_anf-ts-1"}],"layout":"bioLayout","role":"body","text":"Lauren Kaori Gurley is the labor reporter for The Washington Post. She previously covered labor and tech for Vice for three years. ","textStyle":"bioStyle","type":"text"},{"identifier":"_anf-body-12","inlineTextStyles":[{"range":{"length":140,"start":0},"textStyle":"_anf-ts-1"}],"layout":"bioLayout","role":"body","text":"Justin Jouvenal covers the Supreme Court. He previously covered policing and the courts locally and nationally. He joined The Post in 2009. ","textStyle":"bioStyle","type":"text"}],"identifier":"_anf-container-4","layout":"storyContainerLayout","role":"container","type":"container"},{"allowAutoplacedAds":false,"components":[{"allowAutoplacedAds":false,"components":[{"identifier":"_anf-logo-5","imageIdentifier":"0af7d954bc53254b194aba518fdd7409","layout":"ComponentLayout-11","role":"logo","type":"image"},{"identifier":"_anf-heading3-1","layout":"ComponentLayout-12","role":"heading3","text":"Pulitzer Prize—winning content.","textStyle":"_anf-cts-3","type":"text"},{"identifier":"_anf-heading3-2","layout":"ComponentLayout-13","role":"heading3","text":"In your pocket.","textStyle":"_anf-cts-3","type":"text"},{"identifier":"_anf-body-15","inlineTextStyles":[{"range":{"length":69,"start":0},"textSt