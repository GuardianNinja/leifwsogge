]\n\n    elements = [\"Si_Al\", \"Fe_Mg\", \"Pb_U\"]\n    titles = [\n        \"Fine Ash (Si, Al)\",\n        \"Medium Ash (Fe, Mg)\",\n        \"Coarse Ash (Pb, U)\"\n    ]\n\n    for ax, key, title in zip(axes, elements, titles):\n        im = ax.imshow(classified_layers[key], cmap=\"inferno\")\n        ax.set_title(title)\n        plt.colorbar(im, ax=ax)\n\n    plt.tight_layout()\n    plt.show()\n","epoch":3,"telemetryInfo":{}}]],"operations":[{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ash_distribution_plot.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ash_distribution_plot.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ash_distribution_plot.py","scheme":"file"},"requestId":"request_c27d4817-b530-4397-99a0-68d273d75724","epoch":4,"edits":[{"text":"\nimport matplotlib.pyplot as plt\nfrom matplotlib.image import AxesImage\n\ndef plot_distribution(classified_layers):\n    \"\"\"\n    Plots the elemental sediment distribution.\n\n    Parameters:\n        classified_layers (dict): Output from classify_sediment().\n    \"\"\"\n\n    axes = plt.subplots(1, 3, figsize=(15, 5))[1]\n\n    elements = [\"Si_Al\", \"Fe_Mg\", \"Pb_U\"]\n    titles = [\n        \"Fine Ash (Si, Al)\",\n        \"Medium Ash (Fe, Mg)\",\n        \"Coarse Ash (Pb, U)\"\n    ]\n\n    for ax, key, title in zip(axes, elements, titles):\n        im: AxesImage = ax.imshow(classified_layers[key], cmap=\"inferno\")\n        ax.set_title(title)\n        plt.colorbar(im, ax=ax)\n\n    plt.tight_layout()\n    plt.show()\n","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":30,"endColumn":1}}]}],"epochCounter":5},"recentSnapshot":{"entries":[{"resource":"file:///Users/lei