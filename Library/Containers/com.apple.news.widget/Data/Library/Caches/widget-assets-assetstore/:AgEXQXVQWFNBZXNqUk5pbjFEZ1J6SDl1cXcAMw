t":"center","textColor":"#7d7d7d"},"teaserStyle":{"fontName":"FranklinITCStd-Bold","fontSize":18,"identifier":"teaserStyle","lineHeight":26,"textAlignment":"left","textColor":"#2e6d9d"},"timestampStyle":{"fontName":"FranklinITCStd-Light","fontSize":13,"identifier":"timestampStyle","lineHeight":20,"textColor":"#C7261E"}},"components":[{"components":[{"identifier":"_anf-title-1","layout":"authorAltLayout","role":"title","text":"How Social Security has gotten worse under Trump ","type":"text"},{"identifier":"_anf-heading-1","layout":"bylineAltLayout","role":"heading","text":"Customer service deteriorated by key measures as the agency enacted sweeping cuts in Trump’s second term, internal data and interviews show.","textStyle":"deckStyle","type":"text"},{"identifier":"_anf-byline-1","layout":"bylineAltLayout","role":"byline","text":"December 30 at 5:00 AM 2025","type":"text"}],"identifier":"_anf-container-1","layout":"headComponentsContainerLayout","role":"container","style":"bodyStyle","type":"container"},{"components":[{"accessibilityCaption":"How Social Security has gotten worse under Trump ","caption":"The Social Security Administration headquarters in Woodlawn, Maryland, in March. (Wesley Lapointe/For The Washington Post)","captionComponent":{"text":"The Social Security Administration headquarters in Woodlawn, Maryland, in March. (Wesley Lapointe/For The Washington Post)"},"identifier":"_anf-photo-1","imageIdentifier":"891687ced2098ffda3ce98624ce4e820","layout":"headerImageLayout","role":"photo","type":"scalable_image"},{"identifier":"_anf-caption-1","layout":"headerImageCaptionLayout","role":"caption","text":"The Social Security Administration headquarters in Woodlawn, Maryland, in March. (Wesley Lapointe/For The Washington Post)","type":"text"}],"identifier":"_anf-container-2","layout":"headerImageContainerLayout","role":"container","type":"container"},{"components":[{"identifier":"_anf-author-1","inlineTextStyles":[{"range":{"length":49,"start":0},"textStyle":"_anf-ts-1"}],"layout":"authorAltLayout","role":"author","text":"By Lisa Rein, Meryl Kornfield and Hannah Natanson","type":"text"}],"identifier":"_anf-container-3","layout":"authorContainerLayout","role":"container","style":"bodyStyle","type":"container"},{"components":[{"identifier":"_anf-body-1","inlineTextStyles":[{"range":{"length":213,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"The Social Security Administration — the sprawling federal agency that delivers retirement, disability and survivor benefits to 74 million Americans — began the second Trump administration with a hostile takeover.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-2","inlineTextStyles":[{"range":{"length":326,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"It ends the year in turmoil. A diminished workforce has struggled to respond to up to 6 million pending cases in its processing centers and 12 million transactions in its field offices — record backlogs that have delayed basic services to millions of customers, according to internal agency documents and dozens of interviews.","textStyle":"default-body","type":"text"},{"additions":[{"URL":"https://apple.news/AW0DqitwQRgGPeYryAc6OvA","analytics":{"linkType":"web"},"range":{"length":33,"start":56},"type":"link"}],"identifier":"_anf-body-3","inlineTextStyles":[{"range":{"length":312,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":267},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Long-strained customer services at Social Security have become worse by many key measures since President Donald Trump began his second term, agency data and interviews show, as thousands of employees were fired or quit and hasty policy changes and reassignments left inexperienced staff to handle the aftermath.","textStyle":"default-body","type":"text"},{"analytics":{"url":"https://apple.news/TWnoJEyylRkqOFV6TfyhUnA/subscription/weboptin"},"components":[{"components":[{"conditional":[{"conditions":[{"minSpecVersion":"1.14","preferredColorScheme":"dark"}],"hidden":true}],"hidden":false,"identifier":"_anf-logo-2","imageIdentifier":"2f76e00e44a587bb094e7e7b1e7ec698","layout":"ComponentLayout-17","role":"logo","type":"image"},{"conditional":[{"conditions":[{"minSpecVersion":"1.14","preferredColorScheme":"dark"}],"hidden":false}],"hidden":true,"identifier":"_anf-logo-3","imageIdentifier":"36f08a68b52a1951d6f945c280e13008","layout":"ComponentLayout-17","role":"logo","type":"image"},{"conditional":[{"conditions":[{"minViewportWidth":671,"platform":"ios"},{"minViewportWidth":871,"platform":"macos"}],"hidden":true}],"identifier":"_anf-logo-4","imageIdentifier":"959dfd1a20c32ae9a0cc93d2b58255d7","layout":"ComponentLayout-19","role":"logo","type":"image"},{"identifier":"_anf-text-1","inlineTextStyles":[{"range":{"length":35,"start":0},"textStyle":"_anf-ts-6"}],"layout":"ComponentLayout-20","role":"body","text":"Finish setting up your subscription","textStyle":"_anf-moved-1","type":"text"},{"identifier":"_anf-text-2","layout":"ComponentLayout-21","role":"body","text":"Share your email to get unlimited access on washingtonpost.com and The Washington Post app.","textStyle":"_anf-cts-1","type":"text"},{"action":{"URL":"https://apple.news/TWnoJEyylRkqOFV6TfyhUnA/subscription/weboptin","analytics":{"linkType":"article"},"type":"link"},"identifier":"_anf-link_button-1","layout":"ComponentLayout-22","role":"link_button","style":"_anf-cs-2","text":"Share Your Email","textStyle":"_anf-cts-2","type":"button"}],"identifier":"_anf-container-15","layout":"promoContainerLayout","role":"container","type":"container"},{"conditional":[{"conditions":[{"minViewportWidth":671,"platform":"ios"},{"minViewportWidth":871,"platform":"macos"}],"hidden":false,"layout":"ComponentLayout-23"}],"hidden":true,"identifier":"_anf-logo-1","imageIdentifier":"959dfd1a20c32ae9a0cc93d2b58255d7","layout":"_defaultComponentLayout","role":"logo","type":"image"}],"conditional":[{"conditions":[{"configurationKey":"wapo_email_not_shared","minSpecVersion":"1.12"}],"hidden":false}],"contentDisplay":{"type":"horizontal_stack"},"hidden":true,"identifier":"_anf-container-7","layout":"ComponentLayout-1","role":"container","style":"_anf-cs-1","type":"container"},{"identifier":"_anf-body-4","inlineTextStyles":[{"range":{"length":349,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":286},"textStyle":"_anf-ts-11"},{"range":{"length":1,"start":171},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Exaggerated claims of fraud, for example, have led to new roadblocks for elderly beneficiaries, disabled people and legal immigrants, who are now required to complete some transactions in person or online rather than by phone. Even so, the number of calls to the agency for the year hit 93 million as of late September — a six-year high, data shows.","textStyle":"default-body","type":"text"},{"additions":[{"URL":"https://apple.news/PgOTumFKZn0EGkSWtl7W_IH","analytics":{"linkType":"web"},"range":{"length":35,"start":4},"type":"link"}],"identifier":"_anf-body-5","inlineTextStyles":[{"range":{"length":231,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"The troubled disability benefits system is also deteriorating after some improvement, with 66 percent of disability appointments scheduled within 28 days as of December — down from nearly 90 percent earlier in the year, data shows.","textStyle":"default-body","type":"text"},{"animation":{"initialAlpha":0.5,"type":"fade_in","userControllable":true},"identifier":"_anf-photo-2","imageIdentifier":"e8b5e186bef0e4969d12cb7b9af04c1b","layout":"photoAltLayout","role":"photo","type":"scalable_image"},{"additions":[{"URL":"https://apple.news/AODGtsEYnTjGDnIj_xYApzA","analytics":{"linkType":"web"},"range":{"length":49,"start":300},"type":"link"}],"identifier":"_anf-body-6","inlineTextStyles":[{"range":{"length":435,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":85},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"One notable exception is phone service, which improved in the second half of the year but is still subpar. Average hold times peaked at about 2½ hours in March, but dropped starting in July as employees were diverted from field office duties to fix what had become a public relations crisis. Average wait times for callbacks remain an hour or longer, however, while new delays have emerged elsewhere in the system, internal data shows.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-7","inlineTextStyles":[{"range":{"length":381,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":208},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“It was not good before, don’t get me wrong, but the cracks are more than beginning to show,” said John Pfannenstein, a claims specialist outside Seattle and president of Local 3937 of the American Federation of Government Employees, which represents most Social Security employees. “It is a great amount of stress on our employees that remain on the job, who haven’t jumped ship.”","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-8","inlineTextStyles":[{"range":{"length":484,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Commissioner Frank Bisignano has authorized millions of dollars in overtime pay to employees in a race to clear the bottlenecks, which worsened dramatically after nearly 7,000 employees — 12 percent of the workforce — were squeezed out early in the year. The agency said it has made improvements: It reduced the processing center backlog by 1 million cases this fall, cut pending disability claims by a third and kept the website live 24/7 after a series of outages earlier this year.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-9","inlineTextStyles":[{"range":{"length":283,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":227},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"The current crisis follows years of disinvestment by Congress and acting leadership, despite a surge in baby boomer retirements. Bisignano promised faster service and a leaner workforce with a digital identity that he says will automate simple retirement claims and other operations.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-10","inlineTextStyles":[{"range":{"length":346,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“In the coming year, we will continue our digital-first approach to further enhance customer service by introducing new service features and functionality across each of our service channels to better meet the needs of the more than 330 million Americans with Social Security numbers,” the commissioner said in a statement to The Washington Post.","textStyle":"default-body","type":"text"},{"components":[{"animation":{"initialAlpha":0.5,"type":"fade_in","userControllable":true},"caption":"Frank Bisignano, President Donald Trump’s nominee for commissioner of the Social Security Administration, arrives for his confirmation hearing in March. (Maansi Srivastava/For The Washington Post)","captionComponent":{"text":"Frank Bisignano, President Donald Trump’s nominee for commissioner of the Social Security Administration, arrives for his confirmation hearing in March. (Maansi Srivastava/For The Washington Post)"},"identifier":"_anf-photo-4","imageIdentifier":"5de70d3fe616653d4e01d46c5ab801d6","layout":"photoLayout","role":"photo","type":"scalable_image"},{"identifier":"_anf-caption-2","layout":"imageCaptionLayout","role":"caption","text":"Frank Bisignano, President Donald Trump’s nominee for commissioner of the Social Security Administration, arrives for his confirmation hearing in March. (Maansi Srivastava/For The Washington Post)","type":"text"}],"identifier":"_anf-container-8","layout":"imageContainerLayout","role":"container","type":"container"},{"additions":[{"URL":"https://news.gallup.com/poll/699251/growing-worry-medicare-social-security.aspx","analytics":{"linkType":"web"},"range":{"length":15,"start":104},"type":"link"}],"identifier":"_anf-body-11","inlineTextStyles":[{"range":{"length":119,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"But responsiveness and trust in the agency have suffered, according to current and former officials and public polling.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-12","inlineTextStyles":[{"range":{"length":243,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":96},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"This account of the crisis at Social Security is based on internal documents and interviews with 41 current and former employees, advocates and customers, many of whom spoke on the condition of anonymity to speak candidly about their concerns.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-13","inlineTextStyles":[{"range":{"length":124,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Social Security officials declined to make Bisignano available for an interview, though he did respond to written questions.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-14","inlineTextStyles":[{"range":{"length":285,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Three days before Christmas, Brian Morrissey, 65, arrived at the field office in Silver Spring, Maryland, for an appointment to apply for Medicare. He had tried the “MySSA” website, “but navigating it was just really hard,” he said. Morrissey owns a home improvement business, he said.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-15","inlineTextStyles":[{"range":{"length":186,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“If they can make the process easier online, great, but right now it is not well designed,” he said. So his wife waited 30 minutes on hold to schedule a face-to-face appointment for him.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-16","inlineTextStyles":[{"range":{"length":412,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Aime Ledoux Tchameni, an immigrant from Cameroon, waited in line at the Silver Spring office to get an appointment time to fix his last name from being listed as his first name — a mistake that occurred when he came to the U.S. two years ago. He has a provisional driver’s license from Maryland and needs to clear up his name with Social Security by mid-January, he said. But his appointment is not until Feb. 9.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-17","inlineTextStyles":[{"range":{"length":169,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“This is really going to cause me problems, because I need my driver’s license to get to work,” Tchameni said in French. “I don’t understand why I have to wait so long.”","textStyle":"default-body","type":"text"},{"identifier":"_anf-heading2-1","inlineTextStyles":[{"range":{"length":22,"start":0},"textStyle":"_anf-ts-27"}],"layout":"headingAltLayout","role":"heading2","text":"‘I flipped the switch’","textStyle":"default-h2","type":"text"},{"additions":[{"URL":"https://apple.news/PgbDLKEvdu-ZSYSMwNKm2pr","analytics":{"linkType":"web"},"range":{"length":53,"start":33},"type":"link"}],"identifier":"_anf-body-18","inlineTextStyles":[{"range":{"length":208,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"The table was set in February by Elon Musk and his Department of Government Efficiency, or DOGE, which installed a loyal, mid-level data analyst with no management experience to lead the $15.4 billion agency.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-19","inlineTextStyles":[{"range":{"length":421,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"That former analyst, Leland Dudek, insists that he saved Social Security from a worse fate under Musk’s cost-cutting team. “I flipped the switch,” he said in a recent interview, referring to his disruptive four-month tenure as acting commissioner. “The casualty of that is a smaller SSA, an SSA that is being, for the first time, subject to the whims of being a political organization, which it was never intended to be.”","textStyle":"default-body","type":"text"},{"additions":[{"URL":"https://apple.news/Avq5Rbxq1QVCITbpTbOd7gQ","analytics":{"linkType":"web"},"range":{"length":19,"start":121},"type":"link"}],"identifier":"_anf-body-20","inlineTextStyles":[{"range":{"length":361,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Regional offices abruptly disappeared in a rushed reorganization. New policies to fight fraud were rolled out only to be canceled or changed, prompting confused customers to jam the phones and the website, which crashed repeatedly. Daily operations in some respects became an endless game of whack-a-mole as employees were pulled from one department to another.","textStyle":"default-body","type":"text"},{"additions":[{"URL":"https://apple.news/PggSlkzCX28Fi8Rfe4zCzFO","analytics":{"linkType":"web"},"range":{"length":32,"start":87},"type":"link"},{"URL":"https://apple.news/PQGesuifk-lEmCT9T7_QcMW","analytics":{"linkType":"web"},"range":{"length":44,"start":129},"type":"link"}],"identifier":"_anf-body-21","inlineTextStyles":[{"range":{"length":174,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Along the way, Social Security also became ground zero in the administration’s quest to gather Americans’ personal data — largely in service of its mass deportation campaign.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-22","inlineTextStyles":[{"range":{"length":371,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"The chaos quickly became a political cudgel, as Democrats saw an opening to defend one of the country’s most popular entitlement programs. Senate Democrats, led by Sen. Elizabeth Warren (Massachusetts), set up a “war room,” holding rallies with former commissioners in both parties and issuing demands for more resources to keep the Trump administration on the defensive.","textStyle":"default-body","type":"text"},{"components":[{"animation":{"initialAlpha":0.5,"type":"fade_in","userControllable":true},"caption":"Doris Anderson, 81, speaks to Rep. Gil Cisneros (D-California) during a town hall about the Trump administration's cuts to the federal workforce and possibly Social Security in El Monte, California, in March. (Gina Ferazzi/Los Angeles Times/Getty Images)","captionComponent":{"text":"Doris Anderson, 81, speaks to Rep. Gil Cisneros (D-California) during a town hall about the Trump administration's cuts to the federal workforce and possibly Social Security in El Monte, California, in March. (Gina Ferazzi/Los Angeles Times/Getty Images)"},"identifier":"_anf-photo-5","imageIdentifier":"86c2532562b6e8314de4710ba54d01d3","layout":"photoLayout","role":"photo","type":"scalable_image"},{"identifier":"_anf-caption-3","layout":"imageCaptionLayout","role":"caption","text":"Doris Anderson, 81, speaks to Rep. Gil Cisneros (D-California) during a town hall about the Trump administration's cuts to the federal workforce and possibly Social Security in El Monte, California, in March. (Gina Ferazzi/Los Angeles Times/Getty Images)","type":"text"}],"identifier":"_anf-container-9","layout":"imageContainerLayout","role":"container","type":"container"},{"identifier":"_anf-body-23","inlineTextStyles":[{"range":{"length":152,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“We’ve kept up the pressure and held Donald Trump, Elon Musk and Frank Bisignano accountable for the chaos they’ve caused,” Warren said in an interview.","textStyle":"default-body","type":"text"},{"additions":[{"URL":"https://apple.news/PQcnJhEg9YzG-NT506wQrwT","analytics":{"linkType":"web"},"range":{"length":39,"start":111},"type":"link"}],"identifier":"_anf-body-24","inlineTextStyles":[{"range":{"length":212,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":2,"start":150},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Many critics note that Bisignano, a Wall Street veteran who became commissioner in May, now wears a second hat as CEO of the Internal Revenue Service — another massive portfolio with a multibillion-dollar budget.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-25","inlineTextStyles":[{"range":{"length":300,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":146},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"In a statement, Bisignano said his shared leadership of Social Security and the IRS “will drive a better outcome for the American public.” He said he envisions “a Social Security Administration that is easier to access, faster to respond, and better prepared to meet the challenges facing Americans.”","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-26","inlineTextStyles":[{"range":{"length":187,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Bisignano also said he is working to improve morale and “have the right level of staffing to operate at peak efficiency and deliver best-in-class customer service to the American people.”","textStyle":"default-body","type":"text"},{"identifier":"_anf-heading2-2","inlineTextStyles":[{"range":{"length":15,"start":0},"textStyle":"_anf-ts-27"}],"layout":"headingAltLayout","role":"heading2","text":"‘Work piles up’","textStyle":"default-h2","type":"text"},{"identifier":"_anf-body-27","inlineTextStyles":[{"range":{"length":162,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"By the time Bisignano was confirmed by the Senate, Social Security had been led by three acting commissioners in six months. He pledged to stabilize the upheaval.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-28","inlineTextStyles":[{"range":{"length":640,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"But he confronted immediate challenges. Dudek had reassigned 2,000 employees in administrative, analytical and technical roles to jobs dealing with the public. Many accepted the switch under threat of firing if they refused. Some began working the phones. But the national toll-free number was still in crisis, so another 1,000 staffers were assigned to the phones in July. The employees were thrown in with minimal training, multiple employees said — and found themselves unable to answer much beyond basic questions. The phone staff was told to keep calls under seven minutes in what became a push for volume over quality, employees said.","textStyle":"default-body","type":"text"},{"animation":{"initialAlpha":0.5,"type":"fade_in","userControllable":true},"identifier":"_anf-photo-3","imageIdentifier":"71a3dbf7d5c8dd72ec0aab002a7ebf18","layout":"photoAltLayout","role":"photo","type":"scalable_image"},{"identifier":"_anf-body-29","inlineTextStyles":[{"range":{"length":238,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Although officials have publicly claimed that wait times have improved to single digits in some cases, those numbers do not account for the time it takes for customers to be called back, according to internal metrics obtained by The Post.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-30","inlineTextStyles":[{"range":{"length":312,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"An audit published by the Social Security inspector general’s office on Dec. 22 confirmed that millions of callers requesting callbacks were counted as zero-minute waits by the agency. The review concluded that the metrics themselves were accurate, however, and showed that customer service overall has improved.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-31","inlineTextStyles":[{"range":{"length":154,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Jenn Jones, AARP’s vice president of financial security, said the improved phone service numbers were “encouraging” but that “more work needs to be done.”","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-32","inlineTextStyles":[{"range":{"length":201,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“Wait times for callbacks remain over an hour, and more than a quarter of callers are not being served — by getting disconnected or never receiving a callback, for instance,” Jones said in a statement.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-33","inlineTextStyles":[{"range":{"length":153,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":121},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Public outcry and pushback from congressional Democrats derailed the planned closure of dozens of field offices that DOGE had said were no longer needed.","textStyle":"default-body","type":"text"},{"components":[{"identifier":"_anf-divider-1","layout":"newsletterSignupTopDividerLayout","role":"divider","stroke":{"color":"#d2d2d2","width":"1.0pt"},"type":"line"},{"additions":[{"URL":"https://subscribe.washingtonpost.com/newsletters/#/bundle/postmost?method=SURL&location=AN","analytics":{"linkType":"web"},"range":{"length":28,"start":0},"type":"link"}],"identifier":"_anf-body-70","inlineTextStyles":[{"range":{"length":28,"start":0},"textStyle":"_anf-ts-1"},{"range":{"length":28,"start":0},"textStyle":"_anf-ts-48"}],"layout":"newsletterBodyLayout","role":"body","text":"Get the Post Most Newsletter","textStyle":"imageAltTextTextStyle","type":"text"},{"identifier":"_anf-body-71","layout":"bioLayout","role":"body","text":"The most popular and interesting stories of the day to keep you in the know. In your inbox, every day.","textStyle":"imageAltTextTextStyle","type":"text"},{"identifier":"_anf-divider-2","layout":"bioLayout","role":"divider","stroke":{"color":"#d2d2d2","width":"1.0pt"},"type":"line"}],"identifier":"_anf-container-10","layout":"_defaultComponentLayout","role":"container","type":"container"},{"identifier":"_anf-body-34","inlineTextStyles":[{"range":{"length":246,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":202},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Meanwhile, Dudek’s workforce cuts led field offices to shed 9 percent of their employees by spring due to early retirement and deferred resignation offers. Overtime was restricted and hiring was frozen, even as customer visits continued to climb.","textStyle":"default-body","type":"text"},{"components":[{"animation":{"initialAlpha":0.5,"type":"fade_in","userControllable":true},"caption":"Leland Dudek, former acting commissioner of the Social Security Administration, in November. (Matt McClain/The Washington Post)","captionComponent":{"text":"Leland Dudek, former acting commissioner of the Social Security Administration, in November. (Matt McClain/The Washington Post)"},"identifier":"_anf-photo-6","imageIdentifier":"efbf3babb2ecf0296fa3c9a311d8af7b","layout":"photoLayout","role":"photo","type":"scalable_image"},{"identifier":"_anf-caption-4","layout":"imageCaptionLayout","role":"caption","text":"Leland Dudek, former acting commissioner of the Social Security Administration, in November. (Matt McClain/The Washington Post)","type":"text"}],"identifier":"_anf-container-11","layout":"imageContainerLayout","role":"container","type":"container"},{"identifier":"_anf-body-35","inlineTextStyles":[{"range":{"length":246,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Shortly after taking office, Bisignano’s field operations chief, Andy Sriubas, wrote in an email to the staff that field offices “are, and will always remain, our front line — our face in the community and the primary point of in-person contact.”","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-36","inlineTextStyles":[{"range":{"length":437,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"In the near term, though, the frontline staff were overwhelmed. Attrition was geographically uneven, with some offices losing a quarter of their employees to early retirement offers just as foot traffic grew, according to a staffing analysis by the AFGE’s research arm, the Strategic Organizing Center. The union calculated that there were about 4,000 beneficiaries for every field office employee from March 2024 to August of this year.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-37","inlineTextStyles":[{"range":{"length":161,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"In several states that ratio is worse, the union found. Wyoming’s single field office, for example, has just 18 employees — or one for every 7,429 beneficiaries.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-38","inlineTextStyles":[{"range":{"length":219,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"The shortages have created temporary office closures in many rural areas, some for days or months at a time. The office in Havre, Montana, has been closed for months, with the nearest one almost two hours away in Butte.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-39","inlineTextStyles":[{"range":{"length":378,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":71},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Today a majority of Social Security staffers who accepted reassignments have not been fully or properly trained, according to several employees with direct knowledge of the initiative. Instruction is often truncated so the staff can respond to customers. Officials said they provide training based on the employee’s level of experience and review the reassigned employees’ work.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-40","inlineTextStyles":[{"range":{"length":135,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“They offered minimal training and basically threw them in to sink or swim,” one veteran employee said of their transferred colleagues.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-41","inlineTextStyles":[{"range":{"length":381,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":285},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Training on the phone system and complicated claims and benefit programs lasted four hours for some reassigned workers when it should have taken six months, another employee said. As a result, some customers still can’t get basic questions answered or are given inaccurate information, according to a half-dozen staffers who answer the phones or work closely with employees who do.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-42","inlineTextStyles":[{"range":{"length":381,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"The increased workload, hiring freeze and departures have made it harder for the staff to complete their daily tasks, said Jordan Harwell, a Butte, Montana, field office employee who is president of AFGE Local 4012. The staff used to find time between calls to process pay stubs, take in new disability applications and schedule appointments, but now “that work piles up,” he said.","textStyle":"default-body","type":"text"},{"components":[{"animation":{"initialAlpha":0.5,"type":"fade_in","userControllable":true},"caption":"A man walks into a Social Security Administration office in Mount Prospect, Illinois, in June. (Nam Y. Huh/AP)","captionComponent":{"text":"A man walks into a Social Security Administration office in Mount Prospect, Illinois, in June. (Nam Y. Huh/AP)"},"identifier":"_anf-photo-7","imageIdentifier":"e93060dbf3e272d9d80b2f4282b31081","layout":"photoLayout","role":"photo","type":"scalable_image"},{"identifier":"_anf-caption-5","layout":"imageCaptionLayout","role":"caption","text":"A man walks into a Social Security Administration office in Mount Prospect, Illinois, in June. (Nam Y. Huh/AP)","type":"text"}],"identifier":"_anf-container-12","layout":"imageContainerLayout","role":"container","type":"container"},{"identifier":"_anf-body-43","inlineTextStyles":[{"range":{"length":430,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"DOGE officials, citing fraud concerns, also required direct deposit changes to be done in person or online — but getting online now calls for new identity verification measures that do not come easily to many elderly or disabled customers. Immigrants approved for green cards to work in the U.S. are now required to get Social Security cards in person under a Trump anti-fraud policy, producing a flood of new field office visits.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-44","inlineTextStyles":[{"range":{"length":373,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"In one Indiana field office, one employee said she drags herself to work every day, dreading what will come next. Although she was hired as a claims specialist, she and her colleagues are being told to prioritize answering the phones, which never stop ringing now that her office is taking calls for both Indiana and parts of Illinois due to reorganizations and reductions.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-45","inlineTextStyles":[{"range":{"length":231,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"That means she is forced to let other work pile up: calls from people asking about decisions in their cases, claims filed online and anyone who tries to submit forms to Social Security — like proof of marriage — through snail mail.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-46","inlineTextStyles":[{"range":{"length":532,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"As the backlogs keep building, she is taking calls from 25 or so people every day, already knowing that she won’t be able to help five or six of them. These are elderly people, often poor or bedridden, who have no way to comply with the change requiring that direct deposit actions take place in person or online. Usually they’re calling because something has happened to their bank accounts and they need to alter their financial information. But they can’t access a computer, the employee said, and driving is out of the question.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-47","inlineTextStyles":[{"range":{"length":235,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"She received a call this month from a 75-year-old man who suffered a massive stroke that left him unable to drive. He’d also had to switch banks and, as a result, hadn’t received Social Security checks for the last two or three months.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-48","inlineTextStyles":[{"range":{"length":224,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“I had to sit there on the phone and tell this guy, ‘You have to find someone to come in … or, do you have a relative with a computer who can help you or something like that?’” she recalled. “He was just like, ‘No, no, no.’”","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-49","inlineTextStyles":[{"range":{"length":161,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"She ended that call by telling the man to call his bank, hoping they might be able to help when her agency, hampered by administration policies, no longer could.","textStyle":"default-body","type":"text"},{"identifier":"_anf-heading2-3","inlineTextStyles":[{"range":{"length":28,"start":0},"textStyle":"_anf-ts-27"},{"range":{"length":28,"start":0},"textStyle":"_anf-ts-69"}],"layout":"headingAltLayout","role":"heading2","text":"‘Everybody started laughing’","textStyle":"default-h2","type":"text"},{"identifier":"_anf-body-50","inlineTextStyles":[{"range":{"length":351,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"As the staff races to answer the phones, other tasks are backing up, including Medicare applications, disability claims that require initial vetting by field offices and other transactions that cannot be solved in one conversation. Any case falling in that category is redirected to a processing center, where the backlogs have been building all year.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-51","inlineTextStyles":[{"range":{"length":300,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"These back-office operations, located across the country, often handle labor-intensive, highly complex cases that do not call for automated resolution. Among the tasks are issuing checks, including for back pay, to disabled people whose denial of benefits was reversed by an administrative law judge.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-52","inlineTextStyles":[{"range":{"length":214,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"As Congress kept funding flat for Social Security over many years, the processing operations fell way behind, requiring headquarters employees to help handle the volume. But it was never as bad as it got this fall.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-53","inlineTextStyles":[{"range":{"length":124,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":33},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Many disability payments now take three to six months to process when they used to take weeks, advocates and employees said.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-54","inlineTextStyles":[{"range":{"length":339,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"At the start of September, one benefits authorizer in a processing center was called into an all-staff meeting with her colleagues, she said. There, management explained that the backlog at the time — 6 million cases — was unacceptable and that everyone would have to work overtime in an attempt to drive it down to 2 million by Christmas.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-55","inlineTextStyles":[{"range":{"length":150,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“When they told us that, everybody started laughing,” she said. “Because there is just absolutely no way to get it down in that short period of time.”","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-56","inlineTextStyles":[{"range":{"length":219,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Still, she and her colleagues have been hustling, she said, processing cases as fast as they can, even as they can see their haste sometimes causes errors. No time to fix them, she has decided: Best to just keep moving.","textStyle":"default-body","type":"text"},{"components":[{"animation":{"initialAlpha":0.5,"type":"fade_in","userControllable":true},"caption":"The Social Security Administration has said it expects to pay $367 million less on payroll this fiscal year than the year before. (Matt McClain/The Washington Post)","captionComponent":{"text":"The Social Security Administration has said it expects to pay $367 million less on payroll this fiscal year than the year before. (Matt McClain/The Washington Post)"},"identifier":"_anf-photo-8","imageIdentifier":"12adb4c95d49ab6955fc251f60dc9a91","layout":"photoLayout","role":"photo","type":"scalable_image"},{"identifier":"_anf-caption-6","layout":"imageCaptionLayout","role":"caption","text":"The Social Security Administration has said it expects to pay $367 million less on payroll this fiscal year than the year before. (Matt McClain/The Washington Post)","type":"text"}],"identifier":"_anf-container-13","layout":"imageContainerLayout","role":"container","type":"container"},{"identifier":"_anf-body-57","inlineTextStyles":[{"range":{"length":231,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Meanwhile, another staffer, who answers phones at a national call center, said she has changed what she says to customers when she realizes their claim can’t be finished in one conversation and must be referred to a payment center.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-58","inlineTextStyles":[{"range":{"length":143,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“I’m supposed to reassure people it’s being worked on,” she said. “But now I avoid giving people a firm date they can expect it to be done by.”","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-59","inlineTextStyles":[{"range":{"length":314,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":1,"start":133},"textStyle":"_anf-ts-11"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Just before Thanksgiving, Bisignano said that starting next year, he hopes to slash field office visits by half. More than 31 million people visited field offices in the last fiscal year — or tried to. Critics say the change will dismantle the fail-safe for those who cannot use computers, no matter how imperfect.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-60","inlineTextStyles":[{"range":{"length":237,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"At the same time, in recent weeks, hundreds of employees who transferred to customer service operations have been recalled to the roles they were originally hired to fill. Others have been reassigned to a new “digital engagement” office.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-61","inlineTextStyles":[{"range":{"length":296,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Social Security has told Congress it plans to put more resources toward IT, with an expected increase of $591 million this fiscal year compared to fiscal 2025, according to the agency’s budget justification. The agency also expects to pay $367 million less on payroll than it did the year before.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-62","inlineTextStyles":[{"range":{"length":224,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"Social Security also plans to roll out a new program that will allow customers to book phone appointments with field offices throughout the country, no matter where they live, according to two people familiar with the plans.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-63","inlineTextStyles":[{"range":{"length":215,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"The goal is to reduce the number of field office visits, though one field office employee said the change will probably lead to a greater workload for staff keeping up with queries from customers outside their area.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-64","inlineTextStyles":[{"range":{"length":97,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“They’ve created problems and now they are trying to fix problems they created,” the worker said.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-65","inlineTextStyles":[{"range":{"length":298,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"During Christmas week, the grind continued for most frontline staff. After Trump signed an executive order last week closing most federal offices on Christmas Eve and Friday, Bisignano told his staff that field offices, teleservice centers, processing centers and more operations would remain open.","textStyle":"default-body","type":"text"},{"identifier":"_anf-body-66","inlineTextStyles":[{"range":{"length":162,"start":0},"textStyle":"_anf-ts-10"}],"layout":"bodyAltLayout","role":"body","style":"bodyStyle","text":"“In order to balance the needs of the public and our workforce, we will solicit interest from employees who would like to work on Wednesday and Friday,” he wrote.","textStyle":"default-body","type":"text"},{"components":[{"identifier":"_anf-divider-3","layout":"authorInfoDividerLayout","role":"divider","stroke":{"color":"#2a2a2a","width":"1.0pt"},"type":"line"}],"identifier":"_anf-container-14","layout":"authorInfoDividerContainerLayout","role":"container","type":"container"},{"identifier":"_anf-body-67","inlineTextStyles":[{"range":{"length":325,"start":0},"textStyle":"_anf-ts-1"}],"layout":"bioLayout","role":"body","text":"Lisa Rein covers federal agencies and the management of government in the Trump administration. At The Washington Post, she has written about the federal workforce; state politics and government in Annapolis, and in Richmond; local government in Fairfax County, Va.; and the redevelopment of Washington and its neighborhoods.","textStyle":"bioStyle","type":"text"},{"identifier":"_anf-body-68","inlineTextStyles":[{"range":{"length":78,"start":0},"textStyle":"_anf-ts-1"}],"layout":"bioLayout","role":"body","text":"Meryl Kornfield is a staff writer on the Politics desk of The Washington Post.","textStyle":"bioStyle","type":"text"},{"identifier":"_anf-body-69","inlineTextStyles":[{"range":{"length":153,"start":0},"textStyle":"_anf-ts-1"}],"layout":"bioLayout","role":"body","text":"Hannah Natanson is a Washington Post reporter covering Trump's reshaping of the government and its effects. Reach her securely on Signal at 202-580-5477.","textStyle":"bioStyle","type":"text"}],"identifier":"_anf-container-4","layout":"storyContainerLayout","role":"container","type":"container"},{"allowAutoplacedAds":false,"components":[{"allowAutoplacedAds":false,"components":[{"identifier":"_anf-logo-5","imageIdentifier":"0af7d954bc53254b194aba518fdd7409","layout":"ComponentLayout-11","role":"logo","type":"image"},{"identifier":"_anf-heading3-1","layout":"ComponentLayout-12","role":"heading3","text":"Pulitzer Prize—winning content.","textStyle":"_anf-cts-3","type":"text"},{"identifier":"_anf-heading3-2","layout":"ComponentLayout-13","role":"heading3","text":"In your pocket.","textStyle":"_anf-cts-3","type":"text"},{"identifier":"_anf-body-72","inlineTextStyles":[{"range":{"length":69,"start":0},"textStyle":"_anf-ts-94"},{"range":{"length":23,"start":9},"textStyle":"_anf-ts-93"}],"layout":"ComponentLayout-14","role":"body","text":"Download The Washington Post app to access The Post wherever you are.","textStyle":"_anf-moved-2","type":"text"},{"accessibilityLabel":"Download app","action":{"URL":"https://apps.apple.com/us/app/washington-post/id352509417","analytics":{"linkType":"web"},"type":"link"},"identifier":"_anf-link_button-2","layout":"ComponentLayout-15","role":"link_button","style":"_anf-cs-4","text":"Download app","textStyle":"_anf-cts-4","type":"button"}],"identifier":"_anf-container-16","layout":"ComponentLayout-10","role":"container","style":"_anf-cs-3","type":"container"}],"identifier":"_anf-container-5","layout":"ComponentLayout-24","role":"container","type":"container"},{"components":[{"identifier":"_anf-divider-4","layout":"taglineContainerDividerLayout","role":"divider","stroke":{"color":"#7d7d7d16","width":"1.0pt"},"type":"line"},{"identifier":"_anf-logo-6","imageIdentifier":"91bc4d2ac559ac4263e3397ca31f99ef","layout":"taglineLogoLayout","role":"logo","type":"image"},{"identifier":"_anf-body-73","layout":"authorAltLayout","role":"body","text":"Democracy Dies in Darkness","textStyle":"taglineTextStyle","type":"text"},{"identifier":"_anf-bod