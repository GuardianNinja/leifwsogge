ash (Fe, Mg): middle 33%\n        Coarse ash (Pb, U): highest 33%\n\n    Parameters:\n        sediment_grid (np.ndarray): Seafloor sediment concentration.\n\n    Returns:\n        dict: Elemental layers { \"Si_Al\": grid, \"Fe_Mg\": grid, \"Pb_U\": grid }\n    \"\"\"\n\n    flat = sediment_grid.flatten()\n    thresholds = np.percentile(flat, [33, 66])\n\n    fine_mask = sediment_grid <= thresholds[0]\n    medium_mask = (sediment_grid > thresholds[0]) & (sediment_grid <= thresholds[1])\n    coarse_mask = sediment_grid > thresholds[1]\n\n    return {\n        \"Si_Al\": sediment_grid * fine_mask,\n        \"Fe_Mg\": sediment_grid * medium_mask,\n        \"Pb_U\": sediment_grid * coarse_mask\n    }\n","epoch":3,"telemetryInfo":{}}]],"operations":[{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/density_classifier.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/density_classifier.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/density_classifier.py","scheme":"file"},"requestId":"request_16204bc6-b451-4199-9b3b-ed9c262ef99d","epoch":4,"edits":[{"text":"try:","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":1,"endColumn":19}}]},{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/density_classifier.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/density_classifier.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/density_classif