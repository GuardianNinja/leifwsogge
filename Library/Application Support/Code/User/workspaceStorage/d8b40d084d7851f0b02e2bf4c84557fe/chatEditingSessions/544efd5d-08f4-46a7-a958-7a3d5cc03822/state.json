]\n\n    elements = [\"Si_Al\", \"Fe_Mg\", \"Pb_U\"]\n    titles = [\n        \"Fine Ash (Si, Al)\",\n        \"Medium Ash (Fe, Mg)\",\n        \"Coarse Ash (Pb, U)\"\n    ]\n\n    for ax, key, title in zip(axes, elements, titles):\n        im = ax.imshow(classified_layers[key], cmap=\"inferno\")\n        ax.set_title(title)\n        plt.colorbar(im, ax=ax)\n\n    plt.tight_layout()\n    plt.show()\n","epoch":3,"telemetryInfo":{}}]],"operations":[{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ash_distribution_plot.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ash_distribution_plot.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ash_distribution_plot.py","scheme":"file"},"requestId":"request_71b21f7b-522d-4010-a281-9b03561b12b3","epoch":4,"edits":[{"text":"try:\n    import matplotlib.pyplot as plt\nexcept ImportError:\n    raise ImportError(\"matplotlib is required for plotting. Please install it with 'pip install matplotlib'.\")\n\ndef plot_distribution(classified_layers):\n    \"\"\"\n    Plots the elemental sediment distribution.\n\n    Parameters:\n        classified_layers (dict): Output from classify_sediment().\n    \"\"\"\n\n    axes = plt.subplots(1, 3, figsize=(15, 5))[1]\n\n    elements = [\"Si_Al\", \"Fe_Mg\", \"Pb_U\"]\n    titles = [\n        \"Fine Ash (Si, Al)\",\n        \"Medium Ash (Fe, Mg)\",\n        \"Coarse Ash (Pb, U)\"\n    ]\n\n    for ax, key, title in zip(axes, elements, titles):\n        im = ax.imshow(classified_layers[key], cmap=\"inferno\")\n        ax.set_title(title)\n        plt.colorbar(im, ax=ax)\n\n    plt.tight_layout()\n    plt.show()\n","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":31,"endColumn":1}}]}],"epochCounter":5},"recentSnapshot":{"entries":[{"resource":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ash_distribution_plot.py","languageId":"python","originalHash":"f2e6a38","currentHash":"f2e6a38","state":1,"snapshotUri":"chat-editing-snapshot-text-model:/Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ash_distribution_plot.py?%7B%22session%22%3A%7B%22%24mid%22%3A1%2C%22external%22%3A%22vscode-chat-session%3A%2F%2Flocal%2FNTQ0ZWZkNWQtMDhmNC00NmE3LWE5NTgtN2EzZDVjYzAzODIy%22%2C%22path%22%3A%22%2FNTQ0ZWZkNWQtMDhmNC00NmE3LWE5NTgtN2EzZDVjYzAzODIy%22%2C%22scheme%22%3A%22vscode-chat-session%22%2C%22authority%22%3A%22local%22%7D%2C%22requestId%22%3A%22%22%2C%22undoStop%22%3A%22%22%7D","telemetryInfo":{"requestId":"request_71b21f7b-522d-4010-a281-9b03561b12b3","agentId":"github.copilot.editingSessionEditor","modelId":"copilot/gpt-4.1","modeId":"ask"}}]}}