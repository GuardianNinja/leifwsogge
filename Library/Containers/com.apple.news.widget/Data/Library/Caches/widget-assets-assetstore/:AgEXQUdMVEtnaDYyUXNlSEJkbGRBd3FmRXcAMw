_anf-container-13","layout":"ComponentLayout-193","role":"container","type":"container"}],"identifier":"_anf-container-7","layout":"ComponentLayout-1","role":"container","style":"body","type":"container"},{"components":[{"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"stroke":{"color":"#333333","style":"solid","width":"1.0pt"}}],"identifier":"_anf-divider-9","layout":"ComponentLayout-18","role":"divider","stroke":{"color":"#dcdcdc","style":"solid","width":"1.0pt"},"type":"line"}],"identifier":"_anf-container-8","layout":"ComponentLayout-1","role":"container","type":"container"},{"additions":[{"URL":"https://www.theguardian.com/us-news/california","analytics":{"linkType":"web"},"range":{"length":10,"start":0},"type":"link"}],"identifier":"_anf-body-22","inlineTextStyles":[{"range":{"length":193,"start":0},"textStyle":"_anf-ts-16"},{"range":{"length":193,"start":0},"textStyle":"_anf-ts-16"}],"layout":"ComponentLayout-198","role":"body","text":"California firefighters have found the body of a California triathlete on a beach north-west of Santa Cruz, almost a week after she went missing amid speculation that she was killed by a shark.","textStyle":"_anf-moved-3","type":"text"},{"additions":[{"URL":"https://apple.news/ANSnkE5qNSAiQjOnDVxlh6w","analytics":{"linkType":"web"},"range":{"length":9,"start":72},"type":"link"},{"URL":"https://www.mercurynews.com/2025/12/28/lovers-point-shark-attack-victim-identified-by-watch-shark-band-on-ankle/?clearUserState=true","analytics":{"linkType":"web"},"range":{"length":10,"start":85},"type":"link"},{"URL":"https://apple.news/PQC6m4nbQE-26lRpjbrcUyW","analytics":{"linkType":"web"},"range":{"length":40,"start":417},"type":"link"}],"identifier":"_anf-body-23","inlineTextStyles":[{"range":{"length":458,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":458,"start":0},"textStyle":"_anf-ts-10"}],"layout":"ComponentLayout-135","role":"body","text":"The remains of Erica Fox were found on Saturday, her father and husband confirmed to local news outlets. Fox, 55, was part of a group of more than a dozen swimmers who left from Lovers Point near Monterey, California, on 21 December, but she never returned to shore. A witness driving by the area reported to authorities that they saw a shark with what appeared to be a human body in its mouth emerge from the water, according to the San Francisco Chronicle.","textStyle":"_anf-moved-3","type":"text"},{"additions":[{"URL":"https://www.mercurynews.com/2025/12/28/lovers-point-shark-attack-victim-identified-by-watch-shark-band-on-ankle/","analytics":{"linkType":"web"},"range":{"length":37,"start":222},"type":"link"},{"URL":"https://apple.news/ANSnkE5qNSAiQjOnDVxlh6w","analytics":{"linkType":"web"},"range":{"length":25,"start":289},"type":"link"},{"URL":"https://www.escapealcatraztri.com/event-information/overview","analytics":{"linkType":"web"},"range":{"length":20,"start":458},"type":"link"}],"identifier":"_anf-body-24","inlineTextStyles":[{"range":{"length":489,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":489,"start":0},"textStyle":"_anf-ts-10"}],"layout":"ComponentLayout-135","role":"body","text":"The disappearance and reports of the shark drew widespread public attention and efforts from authorities to locate Fox. On Sunday, Fox’s husband, Jean-François Vanreusel, and other members of her swim club held a memorial walk along the Lovers Point coastline. Fox’s father, who confirmed the death to NBC Bay Area, described his daughter as an empathetic and kind person who loved to swim, and who had taken part in numerous triathlons including the annual Escape From Alcatraz challenge.","textStyle":"_anf-moved-3","type":"text"},{"additions":[{"URL":"https://files.cityofpacificgrove.org/News/2025/Missing-Swimmer-PG-12-22-25_Suspension%20Press%20Release_FINAL%20(1).pdf?t=202512222032300&t=202512222032300","analytics":{"linkType":"web"},"range":{"length":20,"start":212},"type":"link"}],"identifier":"_anf-body-25","inlineTextStyles":[{"range":{"length":312,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":312,"start":0},"textStyle":"_anf-ts-10"}],"layout":"ComponentLayout-135","role":"body","text":"Authorities last week launched a large-scale search and rescue operation involving multiple US Coast Guard boat crews along with responders from local fire and police departments to look for Fox. The Coast Guard suspended its search last Monday for Fox after a 15-hour operation covering about 84 nautical miles.","textStyle":"_anf-moved-3","type":"text"},{"identifier":"_anf-body-26","inlineTextStyles":[{"range":{"length":242,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":242,"start":0},"textStyle":"_anf-ts-10"}],"layout":"ComponentLayout-135","role":"body","text":"California firefighters announced on Saturday that they had recovered a body on Davenport beach, just south of Santa Cruz. The Santa Cruz county sheriff’s office issued a statement the same day, citing an ongoing investigation into the death.","textStyle":"_anf-moved-3","type":"text"},{"components":[{"components":[{"accessibilityCaption":"First Thing newsletter","identifier":"_anf-image-1","imageIdentifier":"9f3a8af03bebecbc5b378a50624b86d5","layout":"_defaultComponentLayout","role":"image","type":"image"}],"identifier":"_anf-container-14","layout":"ComponentLayout-16","role":"container","style":"_anf-cs-3","type":"container"},{"components":[{"components":[{"components":[{"identifier":"_anf-image-2","imageIdentifier":"f2787ab648a691cb0dbba23d32051b5c","layout":"ComponentLayout-204","role":"image","type":"image"}],"identifier":"_anf-container-20","layout":"ComponentLayout-203","role":"container","type":"container"},{"components":[{"identifier":"_anf-body-32","inlineTextStyles":[{"range":{"length":29,"start":0},"textStyle":"_anf-ts-14"}],"layout":"ComponentLayout-202","role":"body","text":"Free newsletter every weekday","textStyle":"_anf-moved-4","type":"text"}],"identifier":"_anf-container-21","layout":"ComponentLayout-205","role":"container","type":"container"}],"contentDisplay":{"type":"horizontal_stack"},"identifier":"_anf-container-17","layout":"ComponentLayout-202","role":"container","type":"container"},{"components":[{"identifier":"_anf-heading3-1","inlineTextStyles":[{"range":{"length":23,"start":0},"textStyle":"_anf-ts-15"}],"layout":"_defaultComponentLayout","role":"heading3","text":"Sign up for First Thing","textStyle":"_anf-moved-5","type":"text"}],"identifier":"_anf-container-18","layout":"ComponentLayout-207","role":"container","style":"_anf-cs-3","type":"container"},{"components":[{"identifier":"_anf-body-33","inlineTextStyles":[{"range":{"length":98,"start":0},"textStyle":"_anf-ts-16"}],"layout":"_defaultComponentLayout","role":"body","text":"Start the day with the top stories from the US, plus the day’s must-reads from across the Guardian","textStyle":"_anf-moved-6","type":"text"}],"identifier":"_anf-container-19","layout":"ComponentLayout-207","role":"container","style":"_anf-cs-3","type":"container"}],"identifier":"_anf-container-15","layout":"ComponentLayout-201","role":"container","style":"_anf-cs-3","type":"container"},{"components":[{"action":{"URL":"https://www.theguardian.com/info/2018/sep/17/guardian-us-morning-briefing-sign-up-to-stay-informed?CMP=oth_b-aplnews_d-1","analytics":{"linkType":"web"},"type":"link"},"identifier":"_anf-link_button-1","layout":"ComponentLayout-210","role":"link_button","style":"_anf-cs-4","text":"Sign up","textStyle":"_anf-cts-5","type":"button"}],"identifier":"_anf-container-16","layout":"ComponentLayout-209","role":"container","type":"container"}],"identifier":"_anf-container-9","layout":"ComponentLayout-135","role":"container","style":"_anf-cs-1","type":"container"},{"identifier":"_anf-body-27","inlineTextStyles":[{"range":{"length":358,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":358,"start":0},"textStyle":"_anf-ts-10"}],"layout":"ComponentLayout-135","role":"body","text":"“Today, at approximately 2:00 pm, a body was recovered from the ocean south of Davenport Beach. Due to the close proximity to the recent shark attack victim in Monterey County, our agency is working closely with the Monterey County Sheriff’s Office and the Pacific Grove Police Department regarding the recovery,” the Santa Cruz county sheriff’s office said.","textStyle":"_anf-moved-3","type":"text"},{"additions":[{"URL":"https://www.montereycountynow.com/blogs/opinion_blog/today-s-big-local-news-story-has-been-about-a-shark-attack-but-it-s/article_ebda7bc2-5840-4ea9-aa00-a4e84704c43f.html","analytics":{"linkType":"web"},"range":{"length":10,"start":38},"type":"link"}],"identifier":"_anf-body-28","inlineTextStyles":[{"range":{"length":159,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":159,"start":0},"textStyle":"_anf-ts-10"}],"layout":"ComponentLayout-135","role":"body","text":"Editor and fellow swimmer Sara Rubin, writing in Monterey County Weekly, described Fox as a friend and passionate athlete who found peace in the Pacific Ocean.","textStyle":"_anf-moved-3","type":"text"},{"identifier":"_anf-body-29","inlineTextStyles":[{"range":{"length":647,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":647,"start":0},"textStyle":"_anf-ts-10"}],"layout":"ComponentLayout-135","role":"body","text":"“Twenty years ago, Erica Fox and a friend started swimming every Sunday at Lovers Point in Pacific Grove. Since then, multiple books have been written about the science of swimming and what it does for our brains. But Erica never needed a book to tell her what she knew through experience: Swimming in the ocean is a balm for body and mind, an adventure as much as a meditation.” Rubin wrote. “She developed a deeply intimate relationship with the Pacific Ocean not by studying it or by looking at it, but by getting into it—again and again and again, on choppy days and gloriously calm days, logging what I can only guess are thousands of miles.”","textStyle":"_anf-moved-3","type":"text"},{"identifier":"_anf-body-30","inlineTextStyles":[{"range":{"length":243,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":243,"start":0},"textStyle":"_anf-ts-10"}],"layout":"ComponentLayout-135","role":"body","text":"Rubin said that Fox “understood the risk” of swimming in an ocean with a population of great white sharks, and would “object to framing this as an attack, and she would urge us to instead call it an incident—an animal’s behavior is just that”.","textStyle":"_anf-moved-3","type":"text"},{"additions":[{"URL":"https://nrm.dfg.ca.gov/FileHandler.ashx?DocumentID=203224&inline","analytics":{"linkType":"web"},"range":{"length":27,"start":151},"type":"link"}],"identifier":"_anf-body-31","inlineTextStyles":[{"range":{"length":214,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":214,"start":0},"textStyle":"_anf-ts-10"}],"layout":"ComponentLayout-135","role":"body","text":"Although many species of sharks live off the California coast, violent incidents with humans are extremely rare. Prior to Fox’s death, there have been 16 shark-related fatalities in California in the past 75 years.","textStyle":"_anf-moved-3","type":"text"},{"allowAutoplacedAds":false,"components":[{"components":[{"components":[{"anchor":{"originAnchorPosition":"top","targetAnchorPosition":"top"},"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"hidden":true}],"hidden":false,"identifier":"_anf-logo-1","imageIdentifier":"a7ca38bc2602f83f638127dffb2a88d4","layout":"ComponentLayout-214","role":"logo","type":"image"},{"anchor":{"originAnchorPosition":"top","targetAnchorPosition":"top"},"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"hidden":false}],"hidden":true,"identifier":"_anf-logo-2","imageIdentifier":"eb5cb46005dc15c3c921417a05fef65b","layout":"ComponentLayout-214","role":"logo","type":"image"}],"identifier":"_anf-container-24","layout":"ComponentLayout-213","role":"container","style":"_anf-cs-3","type":"container"},{"components":[{"accessibilityCaption":"Help us reach our $2,000,000 goal","conditional":[{"conditions":[{"minColumns":5,"minSpecVersion":"1.10","preferredColorScheme":"light"}],"hidden":false}],"hidden":true,"identifier":"_anf-figure-1","imageIdentifier":"e120f6bcc2ba5c1ddab2294c697ec069","layout":"_defaultComponentLayout","role":"figure","type":"scalable_image"},{"accessibilityCaption":"Help us reach our $2,000,000 goal","conditional":[{"conditions":[{"maxColumns":4,"minSpecVersion":"1.10","preferredColorScheme":"light"}],"hidden":false}],"hidden":true,"identifier":"_anf-figure-2","imageIdentifier":"eedf774bdf4abcd93506fedb5e9b53bc","layout":"_defaultComponentLayout","role":"figure","type":"scalable_image"},{"accessibilityCaption":"Help us reach our $2,000,000 goal","conditional":[{"conditions":[{"minColumns":5,"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"hidden":false}],"hidden":true,"identifier":"_anf-figure-3","imageIdentifier":"f3bc092e52fe364925b08e1e1baf33b0","layout":"_defaultComponentLayout","role":"figure","type":"scalable_image"},{"accessibilityCaption":"Help us reach our $2,000,000 goal","conditional":[{"conditions":[{"maxColumns":4,"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"hidden":false}],"hidden":true,"identifier":"_anf-figure-4","imageIdentifier":"a3b4c00edd84caae3f485ac41e12c728","layout":"_defaultComponentLayout","role":"figure","type":"scalable_image"}],"identifier":"_anf-container-25","layout":"ComponentLayout-16","role":"container","style":"_anf-cs-3","type":"container"},{"identifier":"_anf-body-34","layout":"ComponentLayout-217","role":"body","text":"At this unsettling time","textStyle":"_anf-cts-7","type":"text"}],"identifier":"_anf-container-22","layout":"ComponentLayout-212","role":"container","type":"container"},{"identifier":"_anf-body-1","inlineTextStyles":[{"range":{"length":403,"start":1788},"textStyle":"_anf-ts-27"}],"layout":"ComponentLayout-16","role":"body","text":"We hope you appreciated this article. Before you close this tab, we want to ask if you could spare 37 seconds to support our most important fundraising appeal of the year.\n\nWhen democratic norms and political stability erode, the role of journalism as an engine of scrutiny, truth and accountability becomes increasingly important.\n\nAt the Guardian, we see it as our job not only to report the facts as we find them, but to provide the historical and global context necessary to fully understand the turbulent times in which we’re living. Humanity, curiosity and honesty guide us, and our work is rooted in solidarity with ordinary people and hope for our shared future. We don’t have a single viewpoint, but we do have a shared set of values. We proudly platform voices of dissent, and we are fearless when it comes to investigating corruption and challenging power.\n\nNot every news organization sees its mission this way – and nor is their editorial independence as ironclad as ours. In the past year, several large media outlets have caved to outside pressure at the behest of their corporate and billionaire owners. We are thankful the Guardian is different. \n\nOur only financial obligation is to fund independent journalism in perpetuity: we have no ultrarich owner, no shareholders, no corporate bosses with the power to overrule or influence our editorial decisions. Reader support is what guarantees our survival and safeguards our independence – and every cent we receive is reinvested in our work. \n\nIt has never been more urgent, or more perilous, to pursue reporting that holds power to account and counters the spread of misinformation – and at the Guardian we make our journalism free and accessible to all. Can you spare just 37 seconds now to support our year-end appeal?  We value whatever you can spare, but a recurring contribution makes the most impact, enabling greater investment in our most crucial, fearless journalism. As our thanks to you, we can offer you some great benefits – including unlimited access to the premium Guardian news app and far fewer fundraising messages on our site. We've made it very quick to set up, so we hope you’ll consider it. Thank you. ","textStyle":"_anf-cts-6","type":"text"},{"components":[{"components":[{"components":[{"components":[{"identifier":"_anf-body-2","layout":"ComponentLayout-223","role":"body","text":"Best value","textStyle":"_anf-cts-8","type":"text"}],"identifier":"_anf-container-30","layout":"ComponentLayout-222","role":"container","style":"_anf-cs-5","type":"container"},{"components":[{"components":[{"identifier":"_anf-body-3","layout":"ComponentLayout-135","role":"body","text":"Support $15/month","textStyle":"_anf-cts-9","type":"text"}],"identifier":"_anf-container-32","layout":"ComponentLayout-134","role":"container","type":"container"},{"components":[{"components":[{"components":[{"identifier":"_anf-body-4","inlineTextStyles":[{"range":{"length":18,"start":7},"textStyle":"_anf-ts-28"}],"layout":"ComponentLayout-104","role":"body","text":"Unlock All-access digital benefits:","textStyle":"_anf-cts-10","type":"text"},{"components":[{"components":[{"components":[{"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"hidden":true}],"identifier":"_anf-logo-4","imageIdentifier":"6af19638ce4a233280bce0b325914a2d","layout":"ComponentLayout-102","role":"logo","type":"image"},{"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"light"}],"hidden":true}],"identifier":"_anf-logo-5","imageIdentifier":"8d575d30fdb20a3b22b853b83e9fc642","layout":"ComponentLayout-102","role":"logo","type":"image"}],"identifier":"_anf-container-44","layout":"ComponentLayout-101","role":"container","type":"container"},{"components":[{"identifier":"_anf-body-5","layout":"ComponentLayout-105","role":"body","text":"Unlimited access to the Guardian app","textStyle":"_anf-cts-10","type":"text"}],"identifier":"_anf-container-45","layout":"ComponentLayout-104","role":"container","type":"container"}],"content