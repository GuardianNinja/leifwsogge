{"version":2,"initialFileContents":[["file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py","9ae1603"]],"timeline":{"checkpoints":[{"checkpointId":"471f3d45-564f-4b43-b6aa-edd95cfa4020","epoch":0,"label":"Initial State","description":"Starting point before any edits"},{"checkpointId":"453ce87e-ee70-4e99-8d72-c00f4d9fb798","requestId":"request_b666fc28-8480-48f8-9895-bdae3e115d2d","epoch":1,"label":"Request request_b666fc28-8480-48f8-9895-bdae3e115d2d"},{"checkpointId":"67a8dc4a-bbe2-48c7-a71a-cae23b0f282a","requestId":"request_b666fc28-8480-48f8-9895-bdae3e115d2d","undoStopId":"3250a107-2b3d-4617-b2c4-fa47453658f3","epoch":2,"label":"Request request_b666fc28-8480-48f8-9895-bdae3e115d2d - Stop 3250a107-2b3d-4617-b2c4-fa47453658f3"}],"currentEpoch":43,"fileBaselines":[["file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py::request_b666fc28-8480-48f8-9895-bdae3e115d2d",{"uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py","scheme":"file"},"requestId":"request_b666fc28-8480-48f8-9895-bdae3e115d2d","content":"import numpy as np\n\ndef simulate_deposition(\n    ash_grid: np.ndarray,\n    water_depth=1500,\n    settling_velocity=0.5,\n    ocean_current=(0.2, -0.1)\n)->np.ndarray:\n    \"\"\"\n    Simulates ash settling through the water column and drifting along ocean currents.\n\n    Parameters:\n        ash_grid (np.ndarray): Airborne ash concentration grid.\n        water_depth (float): Depth of water column in meters.\n        settling_velocity (float): m/s settling speed of ash.\n        ocean_current (tuple): (dx, dy) drift per time step.\n\n    Returns:\n        np.ndarray: Sediment layer deposited on the seafloor.\n    \"\"\"\n    # grid_size = ash_grid.shape[0]  # Removed unused variable\n    time_to_settle = water_depth / settling_velocity\n    steps = int(time_to_settle)\n\n    sediment = np.copy(ash_grid)\n\n    for _ in range(steps):\n        sediment = np.roll(\n            sediment,\n            shift=(int(ocean_current[0]), int(ocean_current[1])), # pyright: ignore[reportUnknownArgumentType]\n            axis=(0, 1)\n        )\n\n    return sediment\n","epoch":3,"telemetryInfo":{}}]],"operations":[{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py","scheme":"file"},"requestId":"request_b666fc28-8480-48f8-9895-bdae3e115d2d","epoch":4,"edits":[{"text":"try:","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":1,"endColumn":19}}]},{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Volcanic-Ash-Dispersion-Module/ocean_deposition.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.n