rsion":"1.10","preferredColorScheme":"dark"}],"textColor":"#F2F2F2"}],"fontName":"PublicoHeadline-Bold","fontSize":16,"identifier":"promoBodyStyle","lineHeight":21,"linkStyle":{"underline":{"style":"solid"}},"textAlignment":"left","textColor":"#101010"},"promoHeadlineStyle":{"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"textColor":"#F2F2F2"}],"fontName":"PublicoHeadline-Bold","fontSize":21,"identifier":"promoHeadlineStyle","lineHeight":28,"textAlignment":"left","textColor":"#101010"},"updatingPostMetadataStyle":{"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"textColor":"#F2F2F2"}],"fontName":"ProximaNova-Regular","fontSize":10,"identifier":"updatingPostMetadataStyle","lineHeight":22,"textAlignment":"left","textColor":"#101010","textTransform":"uppercase","tracking":0.16}},"components":[{"components":[{"identifier":"_anf-title-1","layout":"contentFactCheckHeadingLayout","role":"title","text":"House Oversight Committee to hold hearing on alleged fraud in Minnesota public assistance programs","textStyle":"contentTitleStyle","type":"text"},{"identifier":"_anf-divider-1","layout":"dividerLayout","role":"divider","stroke":{"color":"#f2f2f226","width":"1.0pt"},"type":"line"},{"identifier":"_anf-byline-1","layout":"_defaultComponentLayout","role":"byline","text":"BY MELISSA  QUINN \nDECEMBER 31, 2025 / 11:20 AM EST / CBS NEWS","textStyle":"bylineStyle","type":"text"}],"identifier":"_anf-container-1","layout":"headerLayout","role":"container","style":"footerStyle","type":"container"},{"identifier":"_anf-video-1","layout":"heroLayout","resourceIdentifier":"VideoResourceRef-1","role":"video","stillImageIdentifier":"2ae705dae6c0d23acd2128e274c03e1f","type":"video"},{"additions":[{"URL":"https://apple.news/AW8L68GanSPCUaNF5OG9SZA","analytics":{"linkType":"web"},"range":{"length":53,"start":98},"type":"link"}],"identifier":"_anf-body-1","inlineTextStyles":[{"range":{"length":12,"start":0},"textStyle":"_anf-ts-1"}],"layout":"contentFactCheckHeadingLayout","role":"body","text":"Washington — The House Oversight and Government Reform Committee will hold a hearing next week on alleged fraud in Minnesota public assistance programs, Chairman James Comer, announced Wednesday.","textStyle":"contentParagraphStyle","type":"text"},{"identifier":"_anf-body-2","layout":"contentFactCheckHeadingLayout","role":"body","text":"The hearing is set to take place Jan. 7 and will include testimony from Minnesota GOP state lawmakers who have investigated public assistance fraud, Comer said. Minnesota Gov. Tim Walz and Attorney General Keith Ellison, both Democrats, have also been asked to testify at a second hearing on Feb. 10, Comer, a Kentucky Republican, said.","textStyle":"contentParagraphStyle","type":"text"},{"identifier":"_anf-body-3","layout":"contentFactCheckHeadingLayout","role":"body","text":"\"The U.S. Department of Justice is actively investigating, prosecuting, and charging fraudsters who have stolen billions from taxpayers, and Congress has a duty to conduct rigorous oversight of this heist and enact stronger safeguards to prevent fraud in taxpayer-funded programs, as well as strong sanctions to hold offenders accountable,\" Comer said in a statement.","textStyle":"contentParagraphStyle","type":"text"},{"additions":[{"URL":"https://oversight.house.gov/release/chairman-comer-launches-investigation-into-massive-fraud-in-minnesotas-social-services-system-on-governor-walzs-watch/","analytics":{"linkType":"web"},"range":{"length":25,"start":33},"type":"link"}],"identifier":"_anf-body-4","layout":"contentFactCheckHeadingLayout","role":"body","text":"The House Oversight Committee is investigating allegations of money laundering and fraud in Minnesota's public assistance programs. Comer earlier this month asked Walz and Ellison to turn over to House investigators documents and communications about the state's programs and has sought transcribed interviews with state officials.","textStyle":"contentParagraphStyle","type":"text"},{"identifier":"_anf-body-5","layout":"contentFactCheckHeadingLayout","role":"body","text":"\"Minnesota Governor Tim Walz and Attorney General Keith Ellison have either been asleep at the wheel or complicit in a massive fraud involving taxpayer dollars in Minnesota's social services programs,\" Comer said. \"American taxpayers demand and deserve accountability for the theft of their hard-earned money.\"","textStyle":"contentParagraphStyle","type":"text"},{"additions":[{"URL":"https://apple.news/AQM-wTadzRp2Ktt7F3D99eA","analytics":{"linkType":"web"},"range":{"length":34,"start":189},"type":"link"},{"URL":"https://www.cbsnews.com/minnesota/news/medicaid-billing-department-of-human-services-tim-walz/?ftag=CNM-00-10aac3a","analytics":{"linkType":"web"},"range":{"length":38,"start":287},"type":"link"},{"URL":"https://www.cbsnews.com/minnesota/news/walz-minnesota-officials-question-us-attorney-fraud-claim/?ftag=CNM-00-10aac3a","analytics":{"linkType":"web"},"range":{"length":15,"start":368},"type":"link"}],"identifier":"_anf-body-6","layout":"contentFactCheckHeadingLayout","role":"body","text":"More than 90 people face federal charges as a result of what a top prosecutor in Minnesota said was \"industrial-scale fraud.\" The prosecutor, Joe Thompson, said earlier this month that the total amount of fraud in Minnesota could reach $9 billion billed across 14 Medicaid programs that have been deemed \"high risk\" for fraud. Walz and other state officials, however, have questioned that amount.","textStyle":"contentParagraphStyle","type":"text"},{"additions":[{"URL":"https://apple.news/APsCBJPqcTsKq39aBrc1vaA","analytics":{"linkType":"web"},"range":{"length":20,"start":89},"type":"link"},{"URL":"https://www.cbsnews.com/minnesota/live-updates/u-s-attorneys-office-announces-covid-related-fraud-case/?ftag=CNM-00-10aac3a","analytics":{"linkType":"web"},"range":{"length":17,"start":241},"type":"link"}],"identifier":"_anf-body-7","layout":"contentFactCheckHeadingLayout","role":"body","text":"The scandal began when the nonprofit Feeding Our Future, which is based in Minnesota, was accused of stealing from the Federal Child Nutrition Program by falsely claiming to distribute meals during the COVID-19 pandemic. More than 75 people have been charged in the COVID-era fraud scheme, and at least 56 have pleaded guilty.","textStyle":"contentParagraphStyle","type":"text"},{"additions":[{"URL":"https://apple.news/AvN3pOA8mTlq_WSWuOuERYQ","analytics":{"linkType":"web"},"range":{"length":25,"start":254},"type":"link"},{"URL":"https://apple.news/ADRWMi42gQFiOM9YL1Lufzg","analytics":{"linkType":"web"},"range":{"length":21,"start":366},"type":"link"}],"identifier":"_anf-body-8","layout":"contentFactCheckHeadingLayout","role":"body","text":"Since then, federal prosecutors have uncovered alleged fraud schemes involving a now-defunct housing stabilization program in Minnesota and a Medicaid-backed state program that provides services to children with autism. Homeland Security agents are also conducting investigations into child care centers in the state after a conservative YouTuber named Nick Shirley posted a video online over the weekend alleging that nearly a dozen centers that receive public dollars are not providing any services.","textStyle":"contentParagraphStyle","type":"text"},{"identifier":"_anf-body-9","layout":"contentFactCheckHeadingLayout","role":"body","text":"A CBS News analysis of the day care centers mentioned by Shirley found that all but two have active licenses, according to state records, and state regulators visited the active locations within the last six months. While the centers were cited for safety, cleanliness and other issues, there was no recorded evidence of fraud.","textStyle":"contentParagraphStyle","type":"text"},{"additions":[{"URL":"https://apple.news/AJQvq4aR_TYWtqZlpYydvvA","analytics":{"linkType":"web"},"range":{"length":34,"start":113},"type":"link"}],"identifier":"_anf-body-10","layout":"contentFactCheckHeadingLayout","role":"body","text":"Still, in response to the allegations, the Department of Health and Human Services announced Tuesday that it has frozen federal child care payments for Minnesota.","textStyle":"contentParagraphStyle","type":"text"},{"additions":[{"URL":"https://apple.news/AtIiV3QTJQjyK0MDrqePIyw","analytics":{"linkType":"web"},"range":{"length":26,"start":87},"type":"link"}],"identifier":"_anf-body-11","layout":"contentFactCheckHeadingLayout","role":"body","text":"President Trump has denounced Minnesota leaders for their handling of the programs and attacked Somali immigrants, claiming they have \"ripped off\" the state. Many, but not all, of the defendants charged in the fraud schemes are of Somali descent.","textStyle":"contentParagraphStyle","type":"text"},{"identifier":"_anf-body-12","layout":"contentFactCheckHeadingLayout","role":"body","text":"In response to the Trump administration's decision to withhold child-care funding to Minnesota, Walz accused the president of \"politicizing the issue to defund programs that help Minnesotans.\"","textStyle":"contentParagraphStyle","type":"text"},{"identifier":"_anf-body-13","layout":"contentFactCheckHeadingLayout","role":"body","text":"\"This is Trump's long game,\" he wrote on social media. \"We've spent years cracking down on fraudsters. It's a serious issue — but this has been his plan all along.\"","textStyle":"contentParagraphStyle","type":"text"},{"identifier":"_anf-body-14","layout":"contentFactCheckHeadingLayout","role":"body","text":"First published on December 31, 2025 / 11:20 AM EST","textStyle":"contentCopyrightStyle","type":"text"},{"identifier":"_anf-body-15","layout":"contentCopyrightLayout","role":"body","text":"© 2025 CBS Interactive Inc. All Rights Reserved.","textStyle":"contentCopyrightStyle","type":"text"},{"components":[{"additions":[{"URL":"https://apps.apple.com/app/cbs-news-live-breaking-news/id334256223","analytics":{"linkType":"image"},"ty