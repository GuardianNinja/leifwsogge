":"heading3","text":"Related Stories","textStyle":"spotlightMidCircHeadingTextStyle","type":"text"},{"components":[{"components":[{"components":[{"additions":[{"URL":"https://apple.news/AuV89-2e4TEmeN4G2MYQAoQ","analytics":{"linkType":"web"},"range":{"length":76,"start":0},"type":"link"}],"identifier":"_anf-heading4-1","inlineTextStyles":[{"range":{"length":76,"start":0},"textStyle":"nutrient-major"}],"layout":"spotlightMidCircCardHeadingLayout","role":"heading4","text":"Billy Joel Reveals What He Thinks About Fall Out Boy's Cover of His Hit Song","textStyle":"prbHeadingStyle","type":"text"},{"identifier":"_anf-spacer-1","layout":"_defaultComponentLayout","role":"spacer","type":"flexible_spacer"},{"action":{"URL":"https://apple.news/AuV89-2e4TEmeN4G2MYQAoQ","analytics":{"linkType":"web"},"type":"link"},"identifier":"_anf-link_button-2","layout":"spotlightMidCircCardImageLayout","role":"link_button","style":"_anf-cs-2","type":"button"}],"contentDisplay":{"type":"horizontal_stack"},"identifier":"_anf-container-13","layout":"_defaultComponentLayout","role":"container","type":"container"}],"identifier":"_anf-container-11","layout":"spotlightMidCircCardContainerLayout","role":"container","type":"container"},{"identifier":"_anf-divider-1","layout":"_defaultComponentLayout","role":"divider","stroke":{"color":"#d8d8d8","width":"1.0pt"},"type":"line"},{"components":[{"components":[{"additions":[{"URL":"https://apple.news/A88Vo0MusS-GCT_bbR9BZ-Q","analytics":{"linkType":"web"},"range":{"length":124,"start":0},"type":"link"}],"identifier":"_anf-heading4-2","inlineTextStyles":[{"range":{"length":124,"start":0},"textStyle":"nutrient-major"}],"layout":"spotlightMidCircCardHeadingLayout","role":"heading4","text":"Chappell Roan Says She Doesn’t ‘Condone’ Brigitte Bardot’s Views After Paying Tribute to the Late Star: 'Very Disappointing'","textStyle":"prbHeadingStyle","type":"text"},{"identifier":"_anf-spacer-2","layout":"_defaultComponentLayout","role":"spacer","type":"flexible_spacer"},{"action":{"URL":"https://apple.news/A88Vo0MusS-GCT_bbR9BZ-Q","analytics":{"linkType":"web"},"type":"link"},"identifier":"_anf-link_button-3","layout":"spotlightMidCircCardImageLayout","role":"link_button","style":"_anf-cs-3","type":"button"}],"contentDisplay":{"type":"horizontal_stack"},"identifier":"_anf-container-14","layout":"_defaultComponentLayout","role":"container","type":"container"}],"identifier":"_anf-container-12","layout":"spotlightMidCircCardContainerLayout","role":"container","type":"container"}],"identifier":"_anf-container-10","layout":"_defaultComponentLayout","role":"container","type":"container"}],"identifier":"_anf-container-5","layout":"spotlightMidCircContainerLayout","role":"container","style":"spotlightMidCircBorderStyle","type":"container"},{"additions":[{"URL":"https://people.com/tag/bob-dylan/","analytics":{"linkType":"web"},"range":{"length":9,"start":73},"type":"link"},{"URL":"https://apple.news/Af_ZPxJUHTZaElGPpvC8aUg","analytics":{"linkType":"web"},"range":{"length":14,"start":87},"type":"link"}],"identifier":"_anf-body-6","inlineTextStyles":[{"range":{"length":280,"start":0},"textStyle":"default-tag-star-rating-number"},{"range":{"length":280,"start":0},"textStyle":"default-tag-star-rating-number"}],"layout":"fromTheEditorsTextLayout","role":"body","text":"The three people mentioned in the song who are still alive are musicians Bob Dylan and Chubby Checker, as well as Bernhard Goetz, who was charged with murder and criminal possession of a weapon after shooting four Black teenagers after a dispute on a New York subway ride in 1984.","type":"text"},{"additions":[{"URL":"https://repository.library.northeastern.edu/downloads/neu:ms3970662?datastream_id=content","analytics":{"linkType":"web"},"range":{"length":14,"start":5},"type":"link"}],"identifier":"_anf-body-7","inlineTextStyles":[{"range":{"length":163,"start":0},"textStyle":"default-tag-star-rating-number"},{"range":{"length":163,"start":0},"textStyle":"default-tag-star-rating-number"}],"layout":"fromTheEditorsTextLayout","role":"body","text":"In a 1989 interview with Northeastern University's Larry Katz, Joel said the song was written as he was turning 40, and was \"the history teacher in me coming out.\"","type":"text"},{"identifier":"_anf-body-8","inlineTextStyles":[{"range":{"length":202,"start":0},"textStyle":"default-tag-star-rating-number"},{"range":{"length":202,"start":0},"textStyle":"default-tag-star-rating-number"}],"layout":"fromTheEditorsTextLayout","role":"body","text":"\"When I was a kid, we didn’t have a television, so I read a lot. I became a history nut. I wanted to be a history teacher. I always wanted to know what happened to get us to where we are,\" he explained.","type":"text"},{"identifier":"_anf-body-9","inlineTextStyles":[{"range":{"length":437,"start":0},"textStyle":"default-tag-star-rating-number"},{"range":{"length":437,"start":0},"textStyle":"default-tag-star-rating-number"}],"layout":"fromTheEditorsTextLayout","role":"body","text":"\"Well, I was talking with this guy in his 20s, and he was going on about how tough it is to grow up today with AIDS and crack and the homeless. I said, ‘Yeah, I know how you feel. I felt that way growing up.’ \"And he took exception to that. He said, ‘C’mon, nothing happened in the '50s and early ’60s.’ And the history teacher in me went, 'Whoa, didn't you ever hear of the Korean War, the Suez Canal, the Hungarian freedom fighters?' \"","type":"text"},{"URL":"http://youtube.com/embed/eFTLKWw542g","identifier":"_anf-embedwebvideo-1","layout":"socialEmbedLayout","role":"embedvideo","type":"embed_video"},{"identifier":"_anf-body-10","inlineTextStyles":[{"range":{"length":176,"start":0},"textStyle":"default-tag-star-rating-number"},{"range":{"length":176,"start":0},"textStyle":"default-tag-star-rating-number"}],"layout":"fromTheEditorsTextLayout","role":"body","text":"Joel says he then started jotting down all the names and events he could think of from his 40 years of life, noting, \"It started looking like a rap song, so I just kept going.\"","type":"text"},{"identifier":"_anf-body-11","inlineTextStyles":[{"range":{"length":135,"start":0},"textStyle":"default-tag-star-rating-number"},{"range":{"length":135,"start":0},"textStyle":"default-tag-star-rating-number"},{"range":{"length":26,"start":24},"textStyle":"_anf-ts-14"}],"layout":"fromTheEditorsTextLayout","role":"body","text":"In the 1993 documentary Billy Joel: Shades of Grey, he told director David Horn about his dislike for the song, despite its popularity.","type":"text"},{"identifier":"_anf-body-12","inlineTextStyles":[{"range":{"length":124,"start":0},"textStyle":"default-tag-star-rating-number"},{"range":{"length":124,"start":0},"textStyle":"default-tag-star-rating-number"}],"layout":"fromTheEditorsTextLayout","role":"body","text":"\"It's really not much of a song ... If you take the melody by itself, terrible, like a dentist drill,\" he said of the track.","type":"text"},{"additions":[{"URL":"https://apple.news/AxWJi8eM6QzuoiIkj4k9AEg","analytics":{"linkType":"web"},"range":{"length":40,"start":99},"type":"link"}],"identifier":"_anf-body-13","inlineTextStyles":[{"range":{"length":281,"start":0},"textStyle":"default-tag-star-rating-number"},{"range":{"length":281,"start":0},"textStyle":"default-tag-star-rating-number"}],"layout":"fromTheEditorsTextLayout","role":"body","text":"Despite Joel's feelings about it, he continues to play it for audiences to this day. In June 2023, Fall Out Boy released a modernized cover of the song, picking up where the musician left off and filling the lyrics with references to events from the 1990s through the present day. ","type":"text"},{"allowAutoplacedAds":false,"components":[{"components":[{"identifier":"_anf-image-3","imageIdentifier":"40274d6183d7a1e5e2ba2363e55def98","layout":"borderLineIconImageLayout","role":"image","type":"image"}],"conditional":[{"conditions":[{"minSpecVersion":"1.10","preferredColorScheme":"dark"}],"hidden":false}],"hidd