defaultComponentLayout","role":"body","text":"December 30, 2025 10:41 PM UTC","textStyle":"timestamp-style","type":"text"},{"identifier":"_anf-heading1-1","inlineTextStyles":[{"range":{"length":77,"start":0},"textStyle":"_anf-ts-1"}],"layout":"title-layout","role":"heading1","text":"Trump’s funding cuts put America’s consumer watchdog on the brink of collapse","textStyle":"title-style","type":"text"},{"identifier":"_anf-byline-1","inlineTextStyles":[{"range":{"length":19,"start":0},"textStyle":"_anf-ts-1"},{"range":{"length":16,"start":3},"textStyle":"_anf-ts-1"}],"layout":"authors-layout","role":"byline","text":"By Douglas Gillison","textStyle":"authors-style","type":"text"}],"identifier":"_anf-container-1","layout":"_defaultComponentLayout","role":"container","type":"container"},{"allowAutoplacedAds":false,"components":[{"components":[{"accessibilityCaption":"Consumer Financial Protection Bureau (CFPB) workers rally in Washington","captionComponent":{"text":"Consumer Financial Protection Bureau (CFPB) workers rally on the day of a hearing in a case on the Trump administration's mass firings of CFPB workers, outside the U.S. District Court in Washington, D.C., U.S., March 3, 2025. REUTERS/Kent Nishimura"},"identifier":"_anf-gallery-1-0","imageIdentifier":"ba608ad51103f1d2e3f52f0eb17743f7","role":"photo","type":"scalable_image"},{"accessibilityCaption":"Signage is seen at the Consumer Financial Protection Bureau (CFPB) headquarters in Washington, D.C.","captionComponent":{"text":"Signage is seen at the Consumer Financial Protection Bureau (CFPB) headquarters in Washington, D.C., U.S., August 29, 2020. REUTERS/Andrew Kelly"},"identifier":"_anf-gallery-1-1","imageIdentifier":"3c470a1e0041cdafeb2c58509948ecbe","role":"photo","type":"scalable_image"},{"accessibilityCaption":"U.S. Trade Representative Greer testifies on President Trump's trade policy, on Capitol Hill","captionComponent":{"text":"U.S. Senator Elizabeth Warren (D-MA) speaks before a Senate Finance Committee hearing on U.S. President Donald Trump's trade policy, on Capitol Hill in Washington, D.C., U.S., April 8, 2025. REUTERS/Kevin Mohatt/File Photo"},"identifier":"_anf-gallery-1-2","imageIdentifier":"e9df6c9a56bcc534cef29b6f91531b73","role":"photo","type":"scalable_image"}],"identifier":"_anf-gallery-1","items":[{"accessibilityCaption":"Consumer Financial Protection Bureau (CFPB) workers rally in Washington","caption":"Consumer Financial Protection Bureau (CFPB) workers rally on the day of a hearing in a case on the Trump administration's mass firings of CFPB workers, outside the U.S. District Court in Washington, D.C., U.S., March 3, 2025. REUTERS/Kent Nishimura","captionComponent":{"text":"Consumer Financial Protection Bureau (CFPB) workers rally on the day of a hearing in a case on the Trump administration's mass firings of CFPB workers, outside the U.S. District Court in Washington, D.C., U.S., March 3, 2025. REUTERS/Kent Nishimura"},"imageIdentifier":"ba608ad51103f1d2e3f52f0eb17743f7"},{"accessibilityCaption":"Signage is seen at the Consumer Financial Protection Bureau (CFPB) headquarters in Washington, D.C.","caption":"Signage is seen at the Consumer Financial Protection Bureau (CFPB) headquarters in Washington, D.C., U.S., August 29, 2020. REUTERS/Andrew Kelly","captionComponent":{"text":"Signage is seen at the Consumer Financial Protection Bureau (CFPB) headquarters in Washington, D.C., U.S., August 29, 2020. REUTERS/Andrew Kelly"},"imageIdentifier":"3c470a1e0041cdafeb2c58509948ecbe"},{"accessibilityCaption":"U.S. Trade Representative Greer testifies on President Trump's trade policy, on Capitol Hill","caption":"U.S. Senator Elizabeth Warren (D-MA) speaks before a Senate Finance Committee hearing on U.S. President Donald Trump's trade policy, on Capitol Hill in Washington, D.C., U.S., April 8, 2025. REUTERS/Kevin Mohatt/File Photo","captionComponent":{"text":"U.S. Senator Elizabeth Warren (D-MA) speaks before a Senate Finance Committee hearing on U.S. President Donald Trump's trade policy, on Capitol Hill in Washington, D.C., U.S., April 8, 2025. REUTERS/Kevin Mohatt/File Photo"},"imageIdentifier":"e9df6c9a56bcc534cef29b6f91531b73"}],"layout":"gallery-layout","role":"gallery","type":"strip_gallery"},{"identifier":"_anf-caption-1","inlineTextStyles":[{"range":{"length":248,"start":0},"textStyle":"_anf-ts-10"}],"layout":"_defaultComponentLayout","role":"caption","text":"Consumer Financial Protection Bureau (CFPB) workers rally on the day of a hearing in a case on the Trump administration's mass firings of CFPB workers, outside the U.S. District Court in Washington, D.C., U.S., March 3, 2025. REUTERS/Kent Nishimura","textStyle":"caption-style","type":"text"}],"identifier":"_anf-container-2","layout":"full-gallery-container","role":"container","type":"container"},{"allowAutoplacedAds":false,"components":[{"identifier":"_anf-heading2-4","layout":"_defaultComponentLayout","role":"heading2","text":"Summary","textStyle":"summary-title","type":"text"},{"identifier":"_anf-body-42","inlineTextStyles":[{"range":{"length":260,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":260,"start":0},"textStyle":"_anf-ts-7"}],"layout":"summary-list","role":"body","text":"CFPB faces extinction under Trump administration, will run out of money in early 2026\nWarren defends CFPB, says it's crucial for consumer protection against financial abuse\nCritics argue CFPB is redundant, unconstitutional and has been used as political weapon","textStyle":"summary-list","type":"text"}],"identifier":"_anf-container-3","layout":"_defaultComponentLayout","role":"container","type":"container"},{"identifier":"_anf-body-1","inlineTextStyles":[{"range":{"length":231,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":231,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"When Bianca Jones, a 33-year-old special education teacher in Memphis, Tennessee, decided a couple of years ago that she wanted to buy a house, she started digging into her Experian credit report. She was shocked by what she found.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-2","inlineTextStyles":[{"range":{"length":294,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":294,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Her student debt had been double-counted, making it look as though she owed a quarter of a million dollars and putting home ownership out of reach. Jones disputed the items with Experian, one of the major credit reporting agencies, multiple times in writing and over the phone, but got nowhere.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-3","inlineTextStyles":[{"range":{"length":141,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":141,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"\"They kept saying it's been verified, it's been verified…They never investigated. They never tried to remove it,\" Jones said in an interview.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-4","inlineTextStyles":[{"range":{"length":420,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":420,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Eventually, Jones complained to the Consumer Financial Protection Bureau, a federal watchdog created by Congress in 2010 to protect consumers in their financial dealings, helping her lawyers show a judge the lengths she'd gone to mitigate damage to her credit, according to her attorneys, legal papers and a copy of the complaint. That paper trail eventually helped Jones successfully sue Experian to correct her record.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-5","inlineTextStyles":[{"range":{"length":93,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":93,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Jones closed on a house purchase in the Memphis suburb of Millington for $300,000 in January.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-6","inlineTextStyles":[{"range":{"length":128,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":128,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"\"If I didn't have this agency to go to, I don't think I'd be in the house right now,\" said Jones. \"It actually changed my life.\"","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-7","inlineTextStyles":[{"range":{"length":78,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":78,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Experian and the CFPB did not respond to a request for comment on Jones' case.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-heading2-1","inlineTextStyles":[{"range":{"length":22,"start":0},"textStyle":"_anf-ts-1"}],"layout":"paragraph-header-layout","role":"heading2","text":"AGENCY FACING SHUTDOWN","textStyle":"paragraph-header-style","type":"text"},{"identifier":"_anf-body-8","inlineTextStyles":[{"range":{"length":297,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":297,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"In interviews, consumers who had fallen on hard times or known difficulty, lawyers who work with the poor and credit counselors told Reuters the CFPB had been a lifeline for people facing hardship and they feared that, without it, many consumers would be left unprotected from financial predators.","textStyle":"paragraph-style","type":"text"},{"additions":[{"URL":"https://apple.news/A5ih6WD7eShaWEfG5ERfR2g","analytics":{"linkType":"web"},"range":{"length":17,"start":243},"type":"link"}],"identifier":"_anf-body-9","inlineTextStyles":[{"range":{"length":342,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":342,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":17,"start":243},"textStyle":"_anf-ts-1"}],"layout":"paragraph-layout","role":"body","text":"Conceived by Senator Elizabeth Warren to police the type of lending that fueled the 2008 financial crisis, the CFPB has long been a target of conservatives and industry. Congress created the agency as part of post-crash reforms in 2010 as the sole federal body primarily charged with protecting consumers' rights in the financial marketplace.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-10","inlineTextStyles":[{"range":{"length":174,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":174,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"The CFPB now faces extinction under President Donald Trump's second administration, which says the agency is a political weapon for Democrats and a burden on free enterprise.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-11","inlineTextStyles":[{"range":{"length":246,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":246,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Speaking to reporters at the White House in February, Trump said it was \"very important to get rid of the agency,\" claiming, without spelling out evidence, that Warren had \"used that as her little personal agency to go around and destroy people.\"","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-12","inlineTextStyles":[{"range":{"length":293,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":293,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"In an interview, Warren dismissed the criticism as a sign the CFPB was doing its job. \"This is not about vendettas. This is about enforcing the law as it is written, so that billionaires and billionaire corporations don't cheat American families. I think that's a pretty good thing,\" she said.","textStyle":"paragraph-style","type":"text"},{"additions":[{"URL":"https://apple.news/AF6_RDp0USkmDWR1ED0Apqg","analytics":{"linkType":"web"},"range":{"length":36,"start":96},"type":"link"},{"URL":"https://apple.news/AX_50c-ZmR_eJZgabhc2lDQ","analytics":{"linkType":"web"},"range":{"length":42,"start":266},"type":"link"}],"identifier":"_anf-body-13","inlineTextStyles":[{"range":{"length":335,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":335,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":42,"start":266},"textStyle":"_anf-ts-1"},{"range":{"length":36,"start":96},"textStyle":"_anf-ts-1"}],"layout":"paragraph-layout","role":"body","text":"White House Budget Director Russell Vought, a staunch CFPB critic and the agency's acting head, told \"The Charlie Kirk Show\" podcast in October he plans to shutter the CFPB. The administration is fighting in court to fire up to 90% of its workers, while planning to move pending investigations and litigation to the Justice Department.","textStyle":"paragraph-style","type":"text"},{"additions":[{"URL":"https://apple.news/Aj946DtqJTQKXRxM4crsOdA","analytics":{"linkType":"web"},"range":{"length":14,"start":22},"type":"link"},{"URL":"https://apple.news/Aj946DtqJTQKXRxM4crsOdA","analytics":{"linkType":"web"},"range":{"length":27,"start":76},"type":"link"},{"URL":"https://apple.news/AexnGelS_RmKhYquDaTPVWA","analytics":{"linkType":"web"},"range":{"length":44,"start":141},"type":"link"},{"URL":"https://apple.news/Ax-fxNpafQtK2B4EnWpqIQQ","analytics":{"linkType":"web"},"range":{"length":26,"start":215},"type":"link"},{"URL":"https://apple.news/AKVMyZXDlS4240Nf82RzKrw","analytics":{"linkType":"web"},"range":{"length":44,"start":306},"type":"link"}],"identifier":"_anf-body-14","inlineTextStyles":[{"range":{"length":359,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":359,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":44,"start":306},"textStyle":"_anf-ts-1"},{"range":{"length":26,"start":215},"textStyle":"_anf-ts-1"},{"range":{"length":44,"start":141},"textStyle":"_anf-ts-1"},{"range":{"length":27,"start":76},"textStyle":"_anf-ts-1"},{"range":{"length":14,"start":22},"textStyle":"_anf-ts-1"}],"layout":"paragraph-layout","role":"body","text":"The agency says it is due to run out of money in early 2026 and Vought says he cannot legally seek more until the Federal Reserve returns to what the administration deems \"profitability,\" a position a federal judge flatly rejected on Tuesday, finding it without legal merit. Congressional Republicans also slashed the CFPB's maximum allowable funding in July.","textStyle":"paragraph-style","type":"text"},{"additions":[{"URL":"https://apple.news/AWZAy_RGhR3-su_M4ppIUrQ","analytics":{"linkType":"web"},"range":{"length":30,"start":97},"type":"link"},{"URL":"https://apple.news/AVLy_ynDuTjeoaLctjKIzjQ","analytics":{"linkType":"web"},"range":{"length":12,"start":152},"type":"link"},{"URL":"https://apple.news/AuADJXU92R4O_ZeMWd1evIg","analytics":{"linkType":"web"},"range":{"length":21,"start":186},"type":"link"},{"URL":"https://apple.news/ASnB3mc7dRby7NbcLSvUSTQ","analytics":{"linkType":"web"},"range":{"length":17,"start":209},"type":"link"}],"identifier":"_anf-body-15","inlineTextStyles":[{"range":{"length":248,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":248,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":17,"start":209},"textStyle":"_anf-ts-1"},{"range":{"length":21,"start":186},"textStyle":"_anf-ts-1"},{"range":{"length":12,"start":152},"textStyle":"_anf-ts-1"},{"range":{"length":30,"start":97},"textStyle":"_anf-ts-1"}],"layout":"paragraph-layout","role":"body","text":"Together, the administration, congressional Republicans and industry-backed lawsuits have undone a decade's worth of CFPB rules on matters ranging from medical debt and student loans to credit card late fees, overdraft charges and mortgage lending.","textStyle":"paragraph-style","type":"text"},{"additions":[{"URL":"https://apple.news/AkPBEyuS8QwmZvT3mDkB4_g","analytics":{"linkType":"web"},"range":{"length":30,"start":42},"type":"link"},{"URL":"https://apple.news/AqDNxIq48R0CdmJrjN3g_Ww","analytics":{"linkType":"web"},"range":{"length":35,"start":131},"type":"link"}],"identifier":"_anf-body-16","inlineTextStyles":[{"range":{"length":167,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":167,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":35,"start":131},"textStyle":"_anf-ts-1"},{"range":{"length":30,"start":42},"textStyle":"_anf-ts-1"}],"layout":"paragraph-layout","role":"body","text":"The agency has also dropped or paused its probes and enforcement actions, and stopped supervising the consumer finance industries, leading to a string of resignations.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-17","inlineTextStyles":[{"range":{"length":69,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":69,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"The CFPB and the White House did not respond to requests for comment.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-18","inlineTextStyles":[{"range":{"length":243,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":243,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Warren said that as a law professor studying bankruptcy she saw that consumer protections were weak and fragmented, and that America needed a single federal agency dedicated to protecting consumers from unfair, deceptive and abusive practices.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-19","inlineTextStyles":[{"range":{"length":398,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":398,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"\"I was stunned by the number of people in financial trouble who had lost a job or got sick but who had also been cheated by one or more of their creditors,\" she told Reuters. \"For no agency was consumer protection a first priority, it was somewhere between fifth and tenth, which meant there was just no cop on the beat. If the CFPB is not there, people have nowhere to turn when they get cheated.\"","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-heading2-2","inlineTextStyles":[{"range":{"length":29,"start":0},"textStyle":"_anf-ts-1"}],"layout":"paragraph-header-layout","role":"heading2","text":"CRITICS COMPLAIN OF OVERREACH","textStyle":"paragraph-header-style","type":"text"},{"identifier":"_anf-body-20","inlineTextStyles":[{"range":{"length":548,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":548,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Republicans said the agency was redundant, with federal bank watchdogs, like the Office of the Comptroller of the Currency and Federal Deposit Insurance Corporation, and state regulators already looking out for consumers, and that its funding and leadership structure were unconstitutional. Like other banking regulators, the CFPB's funding is not set annually by Congress and does not come directly from taxpayers. Rather, the agency draws on the Federal Reserve and its director was until recently protected from removal at will by the president.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-21","inlineTextStyles":[{"range":{"length":334,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":334,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Republicans accused the CFPB's first director Richard Cordray, a Democrat, of using those powers to crush small banks and businesses via overzealous enforcement and complex regulations, and of overstepping the agency's legal authority by trying to regulate companies Congress had exempted from its oversight, such as auto dealerships.","textStyle":"paragraph-style","type":"text"},{"additions":[{"URL":"https://apple.news/A8CjJY19uS2218qBsvpgE1g","analytics":{"linkType":"web"},"range":{"length":19,"start":33},"type":"link"},{"URL":"https://reuters.com/article/business/us-supreme-court-gives-president-more-power-over-consumer-financial-agency-idUSKBN24021V/","analytics":{"linkType":"web"},"range":{"length":25,"start":116},"type":"link"},{"URL":"https://apple.news/A3v1qqH4-QmeN_Dmcii6xhg","analytics":{"linkType":"web"},"range":{"length":14,"start":204},"type":"link"}],"identifier":"_anf-body-22","inlineTextStyles":[{"range":{"length":448,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":448,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":14,"start":204},"textStyle":"_anf-ts-1"},{"range":{"length":25,"start":116},"textStyle":"_anf-ts-1"},{"range":{"length":19,"start":33},"textStyle":"_anf-ts-1"}],"layout":"paragraph-layout","role":"body","text":"Conservative and industry groups tried several times to curb its powers or extinguish it altogether via the courts. In 2020 the Supreme Court handed the president the power to fire the director, which he has since used. Critics on the political right accused former director Rohit Chopra, a Democrat, of exceeding his authority, flouting the federal rule-making process, and harming consumers with an ill-conceived crackdown on financial firm fees.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-23","inlineTextStyles":[{"range":{"length":195,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":195,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Thomas Hoenig, who served as vice chair of the FDIC from 2012 to 2018, said he was skeptical of some of the CFPB's work under prior administrations, but that it still served an important purpose.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-24","inlineTextStyles":[{"range":{"length":149,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":149,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"\"If you take them out of the picture altogether, you're going to get more abuse, not less,\" he said. \"I'm disappointed to see the CFPB just go away.\"","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-heading2-3","inlineTextStyles":[{"range":{"length":23,"start":0},"textStyle":"_anf-ts-1"}],"layout":"paragraph-header-layout","role":"heading2","text":"\"VERY IMPORTANT FOR ME\"","textStyle":"paragraph-header-style","type":"text"},{"identifier":"_anf-body-25","inlineTextStyles":[{"range":{"length":368,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":368,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"For some, though, the agency has been a lifeline. Millions of Americans like Jones who are struggling with credit reporting errors, predatory lenders, debt collectors, fraud, discrimination or other challenges, are now filing complaints every year with the agency, which prompts companies to fix the issues, sometimes by paying the complainants, or explain themselves.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-26","inlineTextStyles":[{"range":{"length":181,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":181,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"When companies repeatedly break the rules, the CFPB punishes them and tries to make their customers whole. To date, it has returned $21 billion to consumers, according to CFPB data.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-27","inlineTextStyles":[{"range":{"length":178,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":178,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"Morgan Smith, a 31-year-old single mother and social services worker in Issaquah, Washington, turned to those resources when she realized she had been a victim of identity theft.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-28","inlineTextStyles":[{"range":{"length":294,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":294,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"After her wallet and ID were stolen from her car, she learned that someone had opened up a string of accounts in her name, she said: a rental car that ended up in a crash, an unpaid storage unit and a hotel room at an amusement park. Reuters was unable to confirm Smith's account independently.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-29","inlineTextStyles":[{"range":{"length":221,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":221,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"\"I went straight to the CFPB and I was navigated there to their consumer education tab where I was able to find out how to deal with fraud and scams. It gave me all the information I needed to know...my rights,\" she said.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-30","inlineTextStyles":[{"range":{"length":55,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":55,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"\"That was very important for me to have this resource.\"","textStyle":"paragraph-style","type":"text"},{"additions":[{"URL":"https://reuters.com/article/economy/us-consumer-watchdog-curtails-its-power-to-pursue-abusive-behavior-idUSKBN1ZN2J9/","analytics":{"linkType":"web"},"range":{"length":16,"start":152},"type":"link"}],"identifier":"_anf-body-31","inlineTextStyles":[{"range":{"length":190,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":190,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":16,"start":152},"textStyle":"_anf-ts-1"}],"layout":"paragraph-layout","role":"body","text":"Without the CFPB, borrowers would once again rely on a hodgepodge of federal, state and other local agencies which lack the CFPB's resources, expertise and legal powers, say consumer groups.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-32","inlineTextStyles":[{"range":{"length":321,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":321,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"\"Prior to the CFPB coming around, we'd have to say, 'write your attorney general, write to the FTC,' whoever it was, and it became this sort of letter-writing campaign,\" said Sam Hohman, who runs the Nebraska nonprofit Credit Advisors Foundation, which helps people get out of debt and offers consumer education services.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-33","inlineTextStyles":[{"range":{"length":125,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":125,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"As a result, people like Virginia resident Michael Johnson, 49, may have fewer options in future when they fall into trouble.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-34","inlineTextStyles":[{"range":{"length":277,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":277,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"After a kidney transplant and leg amputation several years ago left Johnson unable to work, he racked up credit card debt paying for basic expenses, he said. This summer he received court summonses from creditors seeking to collect on that old debt, according to court records.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-35","inlineTextStyles":[{"range":{"length":70,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":70,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"\"I got in over my head unintentionally,\" Johnson said in an interview.","textStyle":"paragraph-style","type":"text"},{"additions":[{"URL":"https://www.consumerfinance.gov/credit-cards/agreements/","analytics":{"linkType":"web"},"range":{"length":28,"start":8},"type":"link"}],"identifier":"_anf-body-36","inlineTextStyles":[{"range":{"length":337,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":337,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":28,"start":8},"textStyle":"_anf-ts-1"}],"layout":"paragraph-layout","role":"body","text":"Using a CFPB database of credit card terms and conditions, Johnson learned that his creditors were required to use arbitration rather than sue in court, which could cost more than the underlying debts. Johnson represented himself in court and says so far one creditor has dropped its complaint while the other is considering its options.","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-37","inlineTextStyles":[{"range":{"length":113,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":113,"start":0},"textStyle":"_anf-ts-10"}],"layout":"paragraph-layout","role":"body","text":"\"It adds credibility to your defense that you understand your rights,\" Johnson said. \"Life happens to everybody.\"","textStyle":"paragraph-style","type":"text"},{"identifier":"_anf-body-38","inlineTextStyles":[{"range":{"length":92,"start":0},"textStyle":"_anf-ts-10"}],"layout":"editors","role":"body","text":"Reporting by Douglas Gillison in Washington; Editing by Michelle Price and Michael Learmonth","textStyle":"editors","type":"text"},{"additions":[{"URL":"https://www.thomsonreuters.com/en/about-us/trust-principles.html/","analytics":{"linkType":"web"},"range":{"length":36,"start":15},"type":"link"}],"identifier":"_anf-body-39","inlineTextStyles":[{"range":{"length":51,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":51,"start":0},"textStyle":"_anf-ts-10"},{"range":{"length":36,"start":15},"textStyle":"_anf-ts-1"}],"layout":"paragraph-layout","role":"body","text":"Our Standards: The Thomson Reuters Trust Principles","textStyle":"trust-badge","type":"text"},{"allowAutoplacedAds