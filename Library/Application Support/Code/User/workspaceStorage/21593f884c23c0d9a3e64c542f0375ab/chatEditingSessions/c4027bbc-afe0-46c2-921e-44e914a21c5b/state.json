{"version":2,"initialFileContents":[["file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py","890e631"]],"timeline":{"checkpoints":[{"checkpointId":"d9962482-85ce-402b-9941-78e321a714f9","epoch":0,"label":"Initial State","description":"Starting point before any edits"},{"checkpointId":"ba5dc436-7c3c-485e-9253-46c5252065dd","requestId":"request_3cef6dd6-afa5-44cb-ae2f-56ea92ea63e9","epoch":1,"label":"Request request_3cef6dd6-afa5-44cb-ae2f-56ea92ea63e9"},{"checkpointId":"45e3cf37-7adb-4898-bfa5-72ad7b258ca1","requestId":"request_3cef6dd6-afa5-44cb-ae2f-56ea92ea63e9","undoStopId":"7d889881-08ba-4a96-a36c-578bc32ffe74","epoch":2,"label":"Request request_3cef6dd6-afa5-44cb-ae2f-56ea92ea63e9 - Stop 7d889881-08ba-4a96-a36c-578bc32ffe74"}],"currentEpoch":39,"fileBaselines":[["file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py::request_3cef6dd6-afa5-44cb-ae2f-56ea92ea63e9",{"uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","scheme":"file"},"requestId":"request_3cef6dd6-afa5-44cb-ae2f-56ea92ea63e9","content":"\"\"\"\ngyroscope.py — Gyroscopic stability model\nSpace Leaf Corp — Internal Use Only\n\"\"\"\n\nfrom typing import Optional\nimport numpy as np\n\ndef gyroscopic_S_time_series(\n    counts: list[float],\n    days: int = 3650,\n    omega0: float = 10.0,\n    c: float = 0.5,\n    impulse_every: 'Optional[int]' = None,\n    impulse_drop=0.05\n):\n    radii = [(i + 1) ** 2 for i in range(len(counts))]\n    masses = [cnt * 1e-3 for cnt in counts]\n    I_n = [(2/3) * m * (r**2) for m, r in zip(masses, radii)]\n    I_total = sum(I_n)\n\n    t = np.arange(0, days + 1)\n    omega = omega0 * np.exp(-c * t / days)\n\n    if impulse_every is not None:\n        try:\n            impulse_every_int = int(impulse_every)\n        except (TypeError, ValueError):\n            raise ValueError(\"impulse_every must be an integer or convertible to int\")\n        for day in range(impulse_every_int, days + 1, impulse_every_int):\n            omega[day:] *= (1 - impulse_drop)\n\n    S = omega / omega0\n    return t, S, I_total\n","epoch":3,"telemetryInfo":{}}]],"operations":[{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","scheme":"file"},"requestId":"request_3cef6dd6-afa5-44cb-ae2f-56ea92ea63e9","epoch":4,"edits":[{"text":"\"\"\"","range":{"startLineNumber":1,"startColumn":1,"endLineNumber":1,"endColumn":4}}]},{"type":"textEdit","uri":{"$mid":1,"fsPath":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.secure.net/Main-private-files/giga atom/src/giga_atom/gyroscope.py","external":"file:///Users/leifwsogge/Library/Mobile%20Documents/com~apple~CloudDocs/Space%20LEAF%20Corp.global.secure.net/Main-private-files/giga%20atom/src/giga_atom/gyroscope.py","path":"/Users/leifwsogge/Library/Mobile Documents/com~apple~CloudDocs/Space LEAF Corp.global.s